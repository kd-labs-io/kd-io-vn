---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../data/i18n';
import { siteConfig } from '../config/site';

const lang = 'vi';
const t = getTranslations(lang);
---

<Layout
  lang={lang}
  title="Điều Khoản Dịch Vụ • KD Labs"
  description="Điều khoản dịch vụ của KD Labs cho các ứng dụng phân phối trên Google Play Store."
>
  <div class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Back Link -->
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-semibold text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Quay về trang chủ</span>
      </a>

      <!-- Page Header -->
      <div class="space-y-4 border-b border-stone-200 dark:border-stone-800 pb-8">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-stone-900 dark:text-stone-100">
          {t.termsPage.title}
        </h1>
        <p class="text-xs text-stone-600 dark:text-stone-300 font-mono">
          {t.termsPage.lastUpdated}
        </p>
        <p class="text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal pt-2">
          {t.termsPage.intro}
        </p>
      </div>

      <!-- Sections -->
      <div class="space-y-8">
        {t.termsPage.sections.map((section) => (
          <div class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161412] p-6 sm:p-8 space-y-3 shadow-sm">
            <h2 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-orange-500"></span>
              {section.heading}
            </h2>
            <p class="text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
              {section.content}
            </p>
          </div>
        ))}
      </div>

      <div class="p-6 rounded-3xl bg-stone-100/70 dark:bg-stone-900/50 border border-stone-200 dark:border-stone-800 text-center space-y-2">
        <h3 class="text-sm font-bold text-stone-900 dark:text-stone-100">
          Hỗ trợ pháp lý & bản quyền KD Labs
        </h3>
        <p class="text-xs text-stone-600 dark:text-stone-300">
          Email: <a href={`mailto:${siteConfig.supportEmail}`} class="text-orange-600 dark:text-orange-400 underline font-medium">{siteConfig.supportEmail}</a>
        </p>
      </div>

    </div>
  </div>
</Layout>
