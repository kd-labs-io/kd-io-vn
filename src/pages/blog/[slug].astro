---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getTranslations } from '../../data/i18n';
import { siteConfig } from '../../config/site';
import FormattedDate from '../../components/FormattedDate.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (entry) => entry.id.startsWith('vi/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^vi\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const lang = 'vi';
const t = getTranslations(lang);

// Filter table of contents headings (h2 & h3)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Current canonical URL for social sharing
const postUrl = Astro.url.href;
const siteUrl = Astro.site ? Astro.site.origin : 'https://kd.io.vn';
const blogOgImage = post.data.heroImage;

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: blogOgImage ? (blogOgImage.startsWith('http') ? blogOgImage : `${siteUrl}${blogOgImage}`) : undefined,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    '@id': siteConfig.author.id,
    name: post.data.author && post.data.author !== 'KD Labs' ? post.data.author : 'Bùi Khương Duy',
    url: siteConfig.author.url,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'KD Labs',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/assets/branding/kd-labs-icon.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};
---

<Layout
  lang={lang}
  title={`${post.data.title} • KD Labs`}
  description={post.data.description}
  image={blogOgImage}
  imageAlt={post.data.title}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
  jsonLd={blogJsonLd}
>
  <div class="py-8 sm:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Top Document Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full craft-card text-xs font-semibold text-stone-700 dark:text-stone-200 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-500/50 transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>{t.blogPage.backToBlog}</span>
        </a>

        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full text-[11px] font-mono font-medium bg-stone-100 dark:bg-stone-900 text-stone-600 dark:text-stone-400 border border-stone-200/80 dark:border-stone-800">
            📄 Craft Published Document
          </span>
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-orange-50 dark:bg-orange-950/40 text-orange-700 dark:text-orange-400 border border-orange-200 dark:border-orange-900/50">
              #{post.data.tags[0]}
            </span>
          )}
        </div>
      </div>

      <!-- Main Layout: Craft Document Sheet (8 cols) & Document Outline Sidebar (4 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- Left: Elevated Craft Document Sheet (8 cols) -->
        <div class="lg:col-span-8 space-y-8 min-w-0">
          <div class="rounded-[2rem] craft-document-sheet craft-stack p-6 sm:p-10 lg:p-12 space-y-8">
            
            <!-- Document Header inside Sheet -->
            <header class="space-y-5 border-b border-stone-200/80 dark:border-stone-800/80 pb-7">
              <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-stone-900 dark:text-stone-100 leading-tight text-balance">
                {post.data.title}
              </h1>

              <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
                {post.data.description}
              </p>

              <!-- Meta Bar: Author, Date, Reading Time & Actions -->
              <div class="flex flex-wrap items-center justify-between gap-4 pt-2 text-xs sm:text-sm">
                <div class="flex flex-wrap items-center gap-3.5 text-stone-600 dark:text-stone-300">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-orange-500/15 border border-orange-500/30 flex items-center justify-center text-orange-600 font-bold text-xs">
                      KD
                    </div>
                    <div>
                      <span class="font-semibold text-stone-900 dark:text-stone-100 block leading-tight">{post.data.author}</span>
                      <span class="text-[10px] font-mono text-stone-500 dark:text-stone-400">KD Labs Research</span>
                    </div>
                  </div>

                  <span class="text-stone-300 dark:text-stone-700">•</span>

                  <div class="flex items-center gap-1.5 font-mono text-xs text-stone-500 dark:text-stone-400">
                    <FormattedDate date={post.data.pubDate} locale="vi-VN" />
                  </div>

                  {post.data.readingTime && (
                    <>
                      <span class="text-stone-300 dark:text-stone-700">•</span>
                      <span class="font-mono text-xs text-stone-500 dark:text-stone-400">{post.data.readingTime}</span>
                    </>
                  )}
                </div>

                <!-- Share Button & Copy Link -->
                <div class="flex items-center gap-2">
                  <button
                    id="copy-post-btn"
                    type="button"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800/90 text-stone-700 dark:text-stone-200 text-xs font-medium hover:border-orange-500/50 transition-colors cursor-pointer"
                    title={t.blogPage.copyLink}
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span id="copy-btn-text">{t.blogPage.copyLink}</span>
                  </button>

                  <a
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-full border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800/90 text-stone-700 dark:text-stone-200 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
                    aria-label={t.blogPage.shareTwitter}
                  >
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </header>

            <!-- Hero Image Banner inside Document Sheet -->
            {post.data.heroImage && (
              <div class="rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800 shadow-sm bg-stone-950">
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                  class="w-full h-auto object-cover max-h-[460px]"
                />
              </div>
            )}

            <!-- Craft Document Prose Body -->
            <article class="blog-prose">
              <Content />
            </article>

            <!-- Bottom Tags inside Document Sheet -->
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="pt-6 border-t border-stone-200/80 dark:border-stone-800/80 space-y-3">
                <h4 class="text-[11px] font-mono font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400">
                  Chủ đề liên quan:
                </h4>
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="px-3 py-1 rounded-full text-xs font-mono font-medium bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-700">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Author Box Card -->
          <div class="p-6 rounded-3xl craft-card flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-orange-500/15 border border-orange-500/30 flex items-center justify-center text-orange-600 font-bold text-base flex-shrink-0">
              KD
            </div>
            <div>
              <h4 class="text-sm font-bold text-stone-900 dark:text-stone-100">
                KD Labs — AI-Native Software & Research Lab
              </h4>
              <p class="text-xs text-stone-600 dark:text-stone-400 mt-1 leading-relaxed">
                Nghiên cứu và phát triển các hệ thống phần mềm AI-Native, kiến trúc phân tán, hạ tầng Cloud-Native Kubernetes (K8s) và ứng dụng bảo mật Zero-Trust.
              </p>
            </div>
          </div>

          <!-- Bottom Navigation -->
          <div class="pt-2 flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-4">
            <a
              href="/blog/"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full craft-card text-stone-800 dark:text-stone-200 text-xs font-semibold hover:border-orange-500 hover:text-orange-600 transition-colors !no-underline"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span>{t.blogPage.backToBlog}</span>
            </a>

            <a
              href="/apps/kd-code/"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-orange-600 hover:bg-orange-700 !text-white font-semibold text-xs transition-colors shadow-md shadow-orange-600/20 !no-underline"
            >
              <span class="!text-white">Khám phá KD Code & Simple OTP</span>
              <svg class="w-4 h-4 !text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Sidebar (4 cols): Sticky Craft Document Outline -->
        <aside class="hidden lg:block lg:col-span-4 space-y-6">
          <div class="sticky top-24 space-y-6">
            
            {toc.length > 0 && (
              <div class="rounded-3xl craft-card p-6 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-stone-200/70 dark:border-stone-800">
                  <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 flex items-center gap-2">
                    <svg class="w-4 h-4 text-orange-600 dark:text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                    </svg>
                    <span>{t.blogPage.tableOfContents}</span>
                  </h3>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-500">
                    Outline
                  </span>
                </div>

                <nav id="blog-toc-nav" class="space-y-1 text-xs max-h-[60vh] overflow-y-auto pr-2">
                  {toc.map((heading) => (
                    <a
                      href={`#${heading.slug}`}
                      data-toc-slug={heading.slug}
                      class={`blog-toc-link flex items-start gap-2 px-2.5 py-1.5 rounded-xl hover:bg-stone-100/80 dark:hover:bg-stone-800/60 hover:text-orange-600 dark:hover:text-orange-400 transition-all leading-snug ${
                        heading.depth === 3
                          ? 'pl-5 text-stone-500 dark:text-stone-400'
                          : 'font-medium text-stone-700 dark:text-stone-300'
                      }`}
                    >
                      <span class="toc-dot w-1.5 h-1.5 rounded-full bg-stone-300 dark:bg-stone-700 mt-1.5 shrink-0 transition-colors"></span>
                      <span>{heading.text}</span>
                    </a>
                  ))}
                </nav>
              </div>
            )}

            <!-- Craft Ecosystem Card -->
            <div class="rounded-3xl craft-card p-6 space-y-3 bg-gradient-to-br from-orange-500/10 via-transparent to-transparent">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-emerald-600 text-white">
                Đã có trên App Store
              </span>
              <h4 class="text-base font-bold text-stone-900 dark:text-stone-100">
                Trải nghiệm Simple OTP
              </h4>
              <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed font-normal">
                Ứng dụng 2FA ngoại tuyến 100%, bảo vệ bằng mã hóa phần cứng an toàn tuyệt đối.
              </p>
              <div class="pt-1">
                <a
                  href="/apps/simple-otp/"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400 hover:underline"
                >
                  <span>Xem chi tiết ứng dụng</span>
                  <span>→</span>
                </a>
              </div>
            </div>

          </div>
        </aside>

      </div>

    </div>
  </div>

  <!-- Share Button & Active TOC Outline Client Script -->
  <script is:inline>
    function setupBlogDocumentUX() {
      const copyBtn = document.getElementById('copy-post-btn');
      const copyText = document.getElementById('copy-btn-text');
      if (copyBtn && copyText) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const original = copyText.textContent;
            copyText.textContent = 'Đã sao chép!';
            setTimeout(() => {
              copyText.textContent = original;
            }, 2000);
          } catch (e) {}
        });
      }

      // Active Outline Highlighting
      const headings = document.querySelectorAll('.blog-prose h2[id], .blog-prose h3[id]');
      const tocLinks = document.querySelectorAll('.blog-toc-link');
      if (headings.length && tocLinks.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                tocLinks.forEach((link) => {
                  const isMatch = link.getAttribute('data-toc-slug') === id;
                  const dot = link.querySelector('.toc-dot');
                  link.classList.toggle('bg-orange-500/10', isMatch);
                  link.classList.toggle('text-orange-600', isMatch);
                  link.classList.toggle('dark:text-orange-400', isMatch);
                  link.classList.toggle('font-semibold', isMatch);
                  if (dot) {
                    dot.classList.toggle('bg-orange-500', isMatch);
                    dot.classList.toggle('bg-stone-300', !isMatch);
                    dot.classList.toggle('dark:bg-stone-700', !isMatch);
                  }
                });
              }
            });
          },
          { rootMargin: '-90px 0px -65% 0px', threshold: 0 }
        );
        headings.forEach((h) => observer.observe(h));
      }
    }

    setupBlogDocumentUX();
    document.addEventListener('astro:after-swap', setupBlogDocumentUX);
  </script>

  <!-- Reading Progress Widget -->
  <ReadingProgress label="Tiến độ đọc và cuộn lên đầu trang" />
</Layout>

<style is:global>
  /* Craft Published Document Prose Typography Styling */
  .blog-prose h2 {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    scroll-margin-top: 6rem;
  }
  @media (min-width: 640px) {
    .blog-prose h2 {
      font-size: 1.75rem;
      line-height: 2.25rem;
    }
  }

  .blog-prose h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 6rem;
  }

  .blog-prose p {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-secondary);
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-weight: 400;
  }

  .blog-prose blockquote {
    padding: 1.1rem 1.35rem;
    margin: 1.75rem 0;
    border: 1px solid rgba(234, 88, 12, 0.25);
    border-left: 4px solid #EA580C;
    background-color: rgba(234, 88, 12, 0.05);
    border-radius: 1rem;
    font-style: italic;
    color: var(--text-primary);
  }
  .dark .blog-prose blockquote {
    background-color: rgba(251, 113, 59, 0.07);
    border-color: rgba(251, 113, 59, 0.25);
    border-left-color: #FB713B;
  }

  .blog-prose ul {
    list-style-type: disc;
    margin: 1.25rem 0;
    padding-left: 1.5rem;
    color: var(--text-secondary);
  }

  .blog-prose ol {
    list-style-type: decimal;
    margin: 1.25rem 0;
    padding-left: 1.5rem;
    color: var(--text-secondary);
  }

  .blog-prose li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .blog-prose strong {
    font-weight: 600;
    color: var(--text-primary);
  }

  .blog-prose a {
    color: #EA580C;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: color 0.15s;
  }
  .dark .blog-prose a {
    color: #FB713B;
  }
  .blog-prose a:hover {
    color: #C2410C;
  }

  .blog-prose code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background-color: rgba(120, 113, 108, 0.14);
    color: var(--text-primary);
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
  }

  .blog-prose pre {
    padding: 1.25rem;
    border-radius: 1.15rem;
    background: linear-gradient(180deg, #181715 0%, #100F0E 100%);
    color: #F7F5F0;
    overflow-x: auto;
    margin: 1.75rem 0;
    border: 1px solid #2B2722;
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.06);
  }

  .blog-prose pre code {
    background-color: transparent;
    padding: 0;
    color: inherit;
    font-size: 0.85rem;
  }

  .blog-prose img {
    border-radius: 1.25rem;
    margin: 2rem 0;
    width: 100%;
    height: auto;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
  }

  .blog-prose hr {
    border: none;
    border-top: 1px solid var(--border-primary);
    margin: 2.5rem 0;
  }

  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 1px solid var(--border-primary);
  }

  .blog-prose thead {
    background-color: rgba(234, 88, 12, 0.08);
    border-bottom: 1px solid var(--border-primary);
  }

  .dark .blog-prose thead {
    background-color: rgba(251, 113, 59, 0.12);
  }

  .blog-prose th {
    text-align: left;
    padding: 0.75rem 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .blog-prose td {
    padding: 0.75rem 1rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-subtle);
    vertical-align: top;
  }
</style>
