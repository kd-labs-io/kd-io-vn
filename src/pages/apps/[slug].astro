---
import Layout from '../../layouts/Layout.astro';
import { appsData } from '../../data/apps';
import type { AppItem } from '../../data/apps';
import { getTranslations } from '../../data/i18n';

export function getStaticPaths() {
  return appsData.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppItem;
}

const { app } = Astro.props;
const lang = 'vi';
const t = getTranslations(lang);
const screenshots = app.screenshots ? app.screenshots[lang] : [];
const featureGraphic = app.featureGraphic ? app.featureGraphic[lang] : null;
const siteUrl = Astro.site ? Astro.site.origin : 'https://kd.io.vn';
const appOgImage = featureGraphic || app.iconImage;
const isVsCodeExt = app.platformType === 'vscode_extension';

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  operatingSystem: isVsCodeExt ? 'macOS, Linux, Windows' : (app.appStoreUrl ? 'iOS, Android' : 'Android'),
  applicationCategory: isVsCodeExt ? 'DeveloperApplication' : 'SecurityApplication',
  description: app.shortDescription[lang],
  image: appOgImage ? (appOgImage.startsWith('http') ? appOgImage : `${siteUrl}${appOgImage}`) : undefined,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  downloadUrl: app.appStoreUrl || app.githubUrl || (app.googlePlayUrl !== '#' ? app.googlePlayUrl : undefined),
  author: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Bùi Khương Duy',
  },
  creator: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Bùi Khương Duy',
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'KD Labs',
  },
};
---

<Layout
  lang={lang}
  title={`${app.name} — ${app.category[lang]} • KD Labs`}
  description={app.shortDescription[lang]}
  image={appOgImage}
  imageAlt={`${app.name} - ${app.shortDescription[lang]}`}
  jsonLd={appJsonLd}
>
  <div class="py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Back Link -->
      <a
        href="/#showcase"
        class="inline-flex items-center gap-2 text-xs font-semibold text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{t.appDetail.backToApps}</span>
      </a>

      <!-- Product Header Banner -->
      <div class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161412] p-6 sm:p-10 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8 justify-between">
          
          <div class="flex items-center gap-5">
            <!-- Product Icon -->
            {app.iconImage ? (
              <img
                src={app.iconImage}
                alt={`${app.name} Icon`}
                class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl object-cover shadow-lg shadow-orange-500/20 flex-shrink-0 border border-stone-200 dark:border-stone-800"
              />
            ) : (
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-br from-orange-500 to-orange-700 flex items-center justify-center text-white shadow-lg shadow-orange-500/20 flex-shrink-0">
                <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
            )}

            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-50 dark:bg-orange-950/40 text-orange-700 dark:text-orange-400 border border-orange-200 dark:border-orange-900/50">
                  {app.category[lang]}
                </span>
                <span class="text-xs text-stone-600 dark:text-stone-300">
                  KD Labs (@kd-labs-io)
                </span>
              </div>

              <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100">
                {app.name}
              </h1>

              <div class="flex flex-wrap items-center gap-3 text-xs text-stone-600 dark:text-stone-300">
                <span class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  {app.securityBadge[lang]}
                </span>
                <span>•</span>
                <span class="font-mono text-stone-600 dark:text-stone-300">v{app.version}</span>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="w-full sm:w-auto flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5 sm:gap-3 pt-2 sm:pt-0">
            {app.appStoreUrl && (
              <a
                href={app.appStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md hover:shadow-orange-500/25 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99]"
              >
                <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.06 1.71-.93 2.73.99.08 2.02-.48 2.63-1.23z"/>
                </svg>
                <span>{t.appDetail.downloadOnAppStore}</span>
              </a>
            )}

            {app.githubUrl && (
              <a
                href={app.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl font-semibold text-sm transition-all ${
                  !app.appStoreUrl
                    ? 'bg-orange-600 hover:bg-orange-700 text-white shadow-md hover:shadow-orange-500/25'
                    : 'border border-stone-300 dark:border-stone-700 bg-stone-100/80 dark:bg-stone-800/80 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200'
                }`}
              >
                <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>{t.appDetail.viewGithub}</span>
              </a>
            )}

            {app.protocolUrl && (
              <a
                href={app.protocolUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl border border-stone-300 dark:border-stone-700 bg-stone-100/80 dark:bg-stone-800/80 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 font-mono font-medium text-sm transition-colors"
              >
                <span>Agent Client Protocol (ACP)</span>
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>

        </div>
      </div>

      <!-- Feature Graphic Banner if available -->
      {featureGraphic && (
        <div class="rounded-3xl overflow-hidden border border-stone-200 dark:border-stone-800 shadow-md bg-stone-950">
          <img
            src={featureGraphic}
            alt={`${app.name} Feature Graphic`}
            class="w-full h-auto object-cover"
          />
        </div>
      )}

      <!-- KD Code Architecture & Interactive Workflow Banner (when VS Code extension) -->
      {isVsCodeExt && (
        <div class="rounded-3xl border border-stone-800 bg-stone-950 text-stone-100 p-6 sm:p-8 shadow-xl space-y-6 font-mono">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-stone-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-orange-500 animate-pulse"></span>
              <span class="text-xs sm:text-sm font-bold text-stone-100">
                Kiến trúc Điều phối Agent Client Protocol (ACP) & Git Worktrees
              </span>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-full bg-orange-500/15 text-orange-400 border border-orange-500/30">
              VS Code Secondary Sidebar • Cmd+Alt+A
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
            <div class="p-4 rounded-2xl bg-stone-900/90 border border-stone-800 space-y-2">
              <div class="text-orange-400 font-bold">01. ACP Registry & Agents</div>
              <p class="text-stone-300 font-sans leading-relaxed">
                Cài đặt 1-click Claude, Codex, OpenCode từ ACP Registry hoặc kết nối Agent cục bộ kèm MCP servers & Skills ($).
              </p>
            </div>
            <div class="p-4 rounded-2xl bg-stone-900/90 border border-stone-800 space-y-2">
              <div class="text-orange-400 font-bold">02. Isolated Git Worktrees</div>
              <p class="text-stone-300 font-sans leading-relaxed">
                Mỗi phiên hội thoại hoặc tác vụ chạy trên một Git Worktree độc lập, tự động sao chép .env/node_modules và kiểm tra an toàn.
              </p>
            </div>
            <div class="p-4 rounded-2xl bg-stone-900/90 border border-emerald-500/40 space-y-2">
              <div class="text-emerald-400 font-bold">03. Best-of-N Diff & Merge</div>
              <p class="text-stone-300 font-sans leading-relaxed">
                Gửi cùng 1 prompt cho nhiều Agent/Model, đối chiếu diff trực tiếp (Keep/Undo), gộp nhánh hoặc tạo Pull Request qua GitHub CLI.
              </p>
            </div>
          </div>

          {app.installCommand && (
            <div class="p-4 rounded-2xl bg-stone-900 border border-stone-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
              <div>
                <span class="text-stone-400 block text-[11px]">Khởi chạy từ mã nguồn (Yêu cầu VS Code ≥ 1.123):</span>
                <code class="text-orange-300 font-bold">git clone https://github.com/kd-labs-io/kd-code-extension && cd kd-code-extension && {app.installCommand}</code>
              </div>
              <span class="shrink-0 text-[11px] text-emerald-400 bg-emerald-950/60 px-2.5 py-1 rounded-lg border border-emerald-800/50">
                MIT License
              </span>
            </div>
          )}
        </div>
      )}

      <!-- Main Two Column Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left: Full Details & Screenshots (7 cols) -->
        <div class="lg:col-span-7 space-y-10">
          
          <!-- About Product -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-stone-900 dark:text-stone-100">
              Giới thiệu dự án
            </h2>
            <p class="text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
              {app.fullDescription[lang]}
            </p>
          </div>

          <!-- Key Features -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-stone-900 dark:text-stone-100">
              Tính năng cốt lõi
            </h2>
            <div class="space-y-2.5">
              {app.features[lang].map((feature) => (
                <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-white dark:bg-[#161412] border border-stone-200 dark:border-stone-800">
                  <div class="w-5 h-5 rounded-full bg-orange-500/10 text-orange-600 dark:text-orange-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-sm text-stone-700 dark:text-stone-300 font-medium">
                    {feature}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Screenshots Showcase Gallery -->
          {screenshots.length > 0 && (
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-stone-900 dark:text-stone-100">
                  {t.appDetail.screenshots}
                </h2>
                <span class="sm:hidden text-xs text-stone-500 dark:text-stone-400">Vuốt ngang để xem →</span>
              </div>
              
              <div class="flex sm:grid sm:grid-cols-2 overflow-x-auto snap-x snap-mandatory gap-4 -mx-4 px-4 sm:mx-0 sm:px-0 pb-2 sm:pb-0 no-scrollbar">
                {screenshots.map((shot, idx) => (
                  <div class="w-[78%] shrink-0 snap-center sm:w-auto rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800 shadow-md bg-stone-950 group">
                    <img
                      src={shot}
                      alt={`${app.name} Screenshot ${idx + 1}`}
                      class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- What's New -->
          {app.whatsNew && (
            <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161412] p-6 space-y-3">
              <h3 class="text-sm font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-orange-500"></span>
                {t.appDetail.whatsNew}
              </h3>
              <pre class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 font-sans whitespace-pre-line leading-relaxed">
                {app.whatsNew[lang]}
              </pre>
            </div>
          )}

        </div>

        <!-- Right: Technical Specs Sidebar (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Specs Card -->
          <div class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161412] p-6 space-y-4 shadow-sm">
            <h3 class="text-base font-bold text-stone-900 dark:text-stone-100 border-b border-stone-100 dark:border-stone-800/80 pb-3">
              {t.appDetail.specifications}
            </h3>

            <div class="space-y-3 text-xs sm:text-sm">
              <div class="flex items-center justify-between py-1 border-b border-stone-100 dark:border-stone-900">
                <span class="text-stone-600 dark:text-stone-300">{t.appDetail.packageId}</span>
                <span class="font-mono font-medium text-stone-800 dark:text-stone-200">{app.packageName}</span>
              </div>

              <div class="flex items-center justify-between py-1 border-b border-stone-100 dark:border-stone-900">
                <span class="text-stone-600 dark:text-stone-300">{t.showcase.version}</span>
                <span class="font-medium text-stone-800 dark:text-stone-200">{app.version}</span>
              </div>

              <div class="flex items-center justify-between py-1 border-b border-stone-100 dark:border-stone-900">
                <span class="text-stone-600 dark:text-stone-300">{t.appDetail.size}</span>
                <span class="font-medium text-stone-800 dark:text-stone-200">{app.size}</span>
              </div>

              <div class="flex items-center justify-between py-1 border-b border-stone-100 dark:border-stone-900">
                <span class="text-stone-600 dark:text-stone-300">{t.appDetail.osRequirement}</span>
                <span class="font-medium text-stone-800 dark:text-stone-200 text-right">{app.osRequirement}</span>
              </div>

              <div class="flex items-center justify-between py-1">
                <span class="text-stone-600 dark:text-stone-300">{t.appDetail.lastUpdate}</span>
                <span class="font-medium text-stone-800 dark:text-stone-200">{app.lastUpdated}</span>
              </div>
            </div>
          </div>

          <!-- Security & Privacy Pledge Card -->
          <div class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900/60 p-6 space-y-3">
            <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold text-xs uppercase tracking-wider">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>{t.appDetail.dataProtection}</span>
            </div>
            
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
              {app.securityPledge ? app.securityPledge[lang] : t.appDetail.dataProtectionText}
            </p>

            <div class="pt-2">
              <a
                href="/privacy/"
                class="text-xs font-semibold text-orange-600 dark:text-orange-500 hover:underline"
              >
                Xem Chính sách quyền riêng tư chi tiết →
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</Layout>
