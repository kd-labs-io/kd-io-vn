---
import Layout from '../layouts/Layout.astro';
---

<Layout
  lang="vi"
  title="404 — Không tìm thấy trang | KD Labs"
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển."
>
  <section class="py-24 sm:py-36">
    <div class="max-w-xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-widest bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20">
        404 Not Found
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-stone-900 dark:text-stone-100">
        Không tìm thấy trang
      </h1>
      <p class="text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed">
        Đường dẫn bạn truy cập không tồn tại hoặc đã được chuyển hướng.
      </p>
      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md shadow-orange-600/20 transition-all"
        >
          <span>Quay về trang chủ KD Labs</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
