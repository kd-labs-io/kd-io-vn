---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AppCard from '../components/AppCard.astro';
import FeaturedResearch from '../components/FeaturedResearch.astro';
import Philosophy from '../components/Philosophy.astro';
import DataSafetyBanner from '../components/DataSafetyBanner.astro';
import ContactSection from '../components/ContactSection.astro';
import { appsData } from '../data/apps';
import { siteConfig } from '../config/site';

const lang = 'vi';
---

<Layout
  lang={lang}
  title="KD Labs • Bùi Khương Duy — AI-Native Software & Open-Source Lab"
  description="KD Labs là AI-Native Software & Research Lab sáng lập bởi Bùi Khương Duy (@kd-labs-io) — phát triển KD Code (VS Code ACP Multi-Agent & Git Worktrees), Simple OTP (2FA 100% ngoại tuyến) và nghiên cứu kỹ thuật chuyên sâu."
>
  <!-- Unified Hero + Bento Grid Section -->
  <Hero currentLang={lang} />

  <!-- Equal Products & Open-Source Showcase Section -->
  <section id="showcase" class="py-14 sm:py-24 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-10 sm:mb-14">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20">
          Sản phẩm
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100 text-balance">
          Sản phẩm & Dự án mã nguồn mở
        </h2>
        <p class="text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal text-pretty">
          Mã nguồn mở công khai tại <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="font-mono font-semibold text-orange-600 dark:text-orange-400 hover:underline">github.com/kd-labs-io</a>.
        </p>
      </div>

      <!-- Unified Equal Product Cards List -->
      <div class="space-y-6 sm:space-y-8">
        <div class="flex items-center justify-between gap-3 border-b border-stone-200 dark:border-stone-800 pb-3">
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
            <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 leading-snug truncate">
              Dự Án Chính Thức Tại KD Labs
            </h3>
          </div>
          <a
            href={siteConfig.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 whitespace-nowrap text-[11px] sm:text-xs text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 font-mono px-3 py-1 rounded-full bg-stone-100 dark:bg-stone-800/80 transition-colors"
          >
            @kd-labs-io • {appsData.length} Dự án
          </a>
        </div>

        <div class="space-y-8">
          {appsData.map((app) => (
            <AppCard app={app} currentLang={lang} />
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Featured Research & Blog Section -->
  <FeaturedResearch currentLang={lang} />

  <!-- Philosophy Section -->
  <Philosophy currentLang={lang} />

  <!-- Privacy & Zero-Trust Compliance Banner -->
  <DataSafetyBanner currentLang={lang} />

  <!-- Contact & FAQ Section -->
  <ContactSection currentLang={lang} />
</Layout>
