---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import AppCard from '../../components/AppCard.astro';
import FeaturedResearch from '../../components/FeaturedResearch.astro';
import Philosophy from '../../components/Philosophy.astro';
import DataSafetyBanner from '../../components/DataSafetyBanner.astro';
import ContactSection from '../../components/ContactSection.astro';
import { appsData } from '../../data/apps';
import { siteConfig } from '../../config/site';

const lang = 'en';
---

<Layout
  lang={lang}
  title="KD Labs • Bui Khuong Duy — AI-Native Software & Open-Source Lab"
  description="KD Labs is an AI-Native Software & Research Lab founded by Bui Khuong Duy (@kd-labs-io) — building KD Code (VS Code ACP Multi-Agent & Git Worktrees), Simple OTP (100% offline 2FA), and deep-tech engineering research."
>
  <!-- Unified Hero + Bento Grid Section -->
  <Hero currentLang={lang} />

  <!-- Equal Products & Open-Source Showcase Section -->
  <section id="showcase" class="py-14 sm:py-24 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4 mb-10 sm:mb-14">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-orange-600 dark:text-orange-500">
          Products & Open-Source Ecosystem
        </span>
        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100 text-balance">
          Production Software & Auditable Craft
        </h2>
        <p class="text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal text-pretty">
          Official software built and open-sourced at <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="font-mono font-semibold text-orange-600 dark:text-orange-400 hover:underline">github.com/kd-labs-io</a> — from AI-Native multi-agent orchestration inside VS Code to hardware-backed mobile security.
        </p>
      </div>

      <!-- Unified Equal Product Cards List -->
      <div class="space-y-6 sm:space-y-8">
        <div class="flex items-center justify-between gap-3 border-b border-stone-200 dark:border-stone-800 pb-3">
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
            <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 leading-snug">
              Official KD Labs Projects
            </h3>
          </div>
          <a
            href={siteConfig.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 whitespace-nowrap text-[11px] sm:text-xs text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 font-mono px-3 py-1 rounded-full bg-stone-100 dark:bg-stone-800/80 transition-colors"
          >
            @kd-labs-io • {appsData.length} Projects
          </a>
        </div>

        <div class="space-y-8">
          {appsData.map((app) => (
            <AppCard app={app} currentLang={lang} />
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Featured Research & Blog Section -->
  <FeaturedResearch currentLang={lang} />

  <!-- Philosophy Section -->
  <Philosophy currentLang={lang} />

  <!-- Privacy & Zero-Trust Compliance Banner -->
  <DataSafetyBanner currentLang={lang} />

  <!-- Contact & FAQ Section -->
  <ContactSection currentLang={lang} />
</Layout>
