---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import StatsBar from '../../components/StatsBar.astro';
import AppCard from '../../components/AppCard.astro';
import AppSlotPlaceholder from '../../components/AppSlotPlaceholder.astro';
import Philosophy from '../../components/Philosophy.astro';
import DataSafetyBanner from '../../components/DataSafetyBanner.astro';
import ContactSection from '../../components/ContactSection.astro';
import { appsData } from '../../data/apps';
import { getTranslations } from '../../data/i18n';

const lang = 'en';
const t = getTranslations(lang);

const flagshipApp = appsData.find((app) => app.id === 'simple-otp') || appsData[0];
const otherSlots = appsData.filter((app) => app.id !== flagshipApp.id);
---

<Layout
  lang={lang}
  title="KD Labs - Developed by Bui Khuong Duy • Keep Developing Software with Passion & Security"
  description="KD Labs - Software Studio. Introducing Simple OTP - 100% Offline 2FA Authenticator with Hardware Enclave Security and Companion Mascots."
>
  <!-- Hero Section -->
  <Hero currentLang={lang} />

  <!-- Trust Metrics Bar -->
  <StatsBar currentLang={lang} />

  <!-- Showcase Section -->
  <section id="showcase" class="py-20 sm:py-28 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto space-y-4 mb-14">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-orange-600 dark:text-orange-500">
          {t.showcase.tagline}
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 dark:text-stone-100">
          {t.showcase.title}
        </h2>
        <p class="text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
          {t.showcase.subtitle}
        </p>
      </div>

      <!-- Featured Flagship Upcoming App: Simple OTP -->
      <div class="space-y-8 mb-16">
        <AppCard app={flagshipApp} currentLang={lang} />
      </div>

      <!-- Upcoming Lab Slots Grid -->
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-orange-500"></span>
            <h3 class="text-sm font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300">
              Projects in Development
            </h3>
          </div>
          <span class="text-xs text-stone-600 dark:text-stone-300 font-mono">
            {otherSlots.length} slots
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          {otherSlots.map((slot) => (
            <AppSlotPlaceholder slot={slot} currentLang={lang} />
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Philosophy Section -->
  <Philosophy currentLang={lang} />

  <!-- Google Play Data Safety Compliance Banner -->
  <DataSafetyBanner currentLang={lang} />

  <!-- Contact & FAQ Section -->
  <ContactSection currentLang={lang} />
</Layout>
