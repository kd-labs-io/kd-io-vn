---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '../../../data/i18n';
import FormattedDate from '../../../components/FormattedDate.astro';

const lang = 'en';
const t = getTranslations(lang);

// Get all English blog posts and sort chronologically
const posts = (
  await getCollection('blog', (entry) => entry.id.startsWith('en/'))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique tags
const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags || [])));
---

<Layout
  lang={lang}
  title={`${t.blogPage.title} • KD Labs - Developed by Bui Khuong Duy`}
  description={t.blogPage.subtitle}
>
  <div class="py-12 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Header Section -->
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-orange-500/10 dark:bg-orange-500/15 text-orange-700 dark:text-orange-400 border border-orange-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
          <span>{t.blogPage.badge}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-stone-900 dark:text-stone-100">
          {t.blogPage.title}
        </h1>

        <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
          {t.blogPage.subtitle}
        </p>

        <!-- Topic Tags Pill List -->
        {allTags.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 pt-2">
            <span class="text-xs text-stone-500 dark:text-stone-400 font-medium">Topics:</span>
            {allTags.map((tag) => (
              <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-700">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>

      <!-- Articles Grid -->
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => {
            const slug = post.id.replace(/^en\//, '');
            const postUrl = `/en/blog/${slug}`;

            return (
              <article class="flex flex-col rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161412] overflow-hidden hover:border-orange-500/40 dark:hover:border-orange-500/40 hover:shadow-xl transition-all duration-300 group">
                
                <!-- Hero Image Cover -->
                {post.data.heroImage && (
                  <a href={postUrl} class="relative block aspect-[16/9] overflow-hidden bg-stone-950">
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                  </a>
                )}

                <!-- Card Content -->
                <div class="flex flex-col flex-grow p-6 sm:p-7 space-y-4 justify-between">
                  <div class="space-y-3">
                    
                    <!-- Meta: Date & Reading Time -->
                    <div class="flex items-center gap-3 text-xs text-stone-500 dark:text-stone-400">
                      <span class="inline-flex items-center gap-1.5 font-medium">
                        <svg class="w-3.5 h-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <FormattedDate date={post.data.pubDate} locale="en-US" />
                      </span>

                      {post.data.readingTime && (
                        <>
                          <span>•</span>
                          <span class="inline-flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            {post.data.readingTime}
                          </span>
                        </>
                      )}
                    </div>

                    <!-- Title -->
                    <h2 class="text-lg sm:text-xl font-bold tracking-tight text-stone-900 dark:text-stone-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors line-clamp-2 leading-snug">
                      <a href={postUrl} class="focus:outline-none">
                        {post.data.title}
                      </a>
                    </h2>

                    <!-- Description -->
                    <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 line-clamp-3 leading-relaxed font-normal">
                      {post.data.description}
                    </p>
                  </div>

                  <!-- Footer of card: Tags & Read more CTA -->
                  <div class="pt-4 border-t border-stone-100 dark:border-stone-800/80 space-y-3">
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-stone-100 dark:bg-stone-800/80 text-stone-600 dark:text-stone-300">
                            #{tag}
                          </span>
                        ))}
                      </div>
                    )}

                    <a
                      href={postUrl}
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-orange-600 dark:text-orange-500 hover:text-orange-700 dark:hover:text-orange-400 group-hover:translate-x-1 transition-all"
                    >
                      <span>{t.blogPage.readMore}</span>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  </div>

                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 rounded-3xl border border-dashed border-stone-300 dark:border-stone-700 p-8">
          <p class="text-stone-500 dark:text-stone-400 text-sm">
            {t.blogPage.noPosts}
          </p>
        </div>
      )}

    </div>
  </div>
</Layout>
