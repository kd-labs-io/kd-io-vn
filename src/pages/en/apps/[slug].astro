---
import Layout from '../../../layouts/Layout.astro';
import AppDetailContent from '../../../components/AppDetailContent.astro';
import { appsData } from '../../../data/apps';
import type { AppItem } from '../../../data/apps';
import { siteConfig } from '../../../config/site';

export function getStaticPaths() {
  return appsData.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppItem;
}

const { app } = Astro.props;
const lang = 'en';
const featureGraphic = app.featureGraphic ? app.featureGraphic[lang] : null;
const siteUrl = Astro.site ? Astro.site.origin : 'https://kd.io.vn';
const appOgImage = featureGraphic || app.iconImage;
const isVsCodeExt = app.platformType === 'vscode_extension';

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  operatingSystem: isVsCodeExt ? 'macOS, Linux, Windows' : (app.appStoreUrl ? 'iOS, Android' : 'Android'),
  applicationCategory: isVsCodeExt ? 'DeveloperApplication' : 'SecurityApplication',
  description: app.shortDescription[lang],
  image: appOgImage ? (appOgImage.startsWith('http') ? appOgImage : `${siteUrl}${appOgImage}`) : undefined,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  downloadUrl: app.appStoreUrl || app.vsMarketplaceUrl || app.githubUrl || (app.googlePlayUrl !== '#' ? app.googlePlayUrl : undefined),
  author: {
    '@type': 'Person',
    '@id': siteConfig.author.id,
    name: 'Bui Khuong Duy',
  },
  creator: {
    '@type': 'Person',
    '@id': siteConfig.author.id,
    name: 'Bui Khuong Duy',
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'KD Labs',
  },
};
---

<Layout
  lang={lang}
  title={`${app.name} — ${app.category[lang]} • KD Labs`}
  description={app.shortDescription[lang]}
  image={appOgImage}
  imageAlt={`${app.name} - ${app.shortDescription[lang]}`}
  jsonLd={appJsonLd}
>
  <AppDetailContent app={app} currentLang={lang} />
</Layout>
