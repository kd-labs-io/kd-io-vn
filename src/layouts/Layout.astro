---
import type { Locale } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n';
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang: Locale;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  tags?: string[];
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title: initialTitle,
  description: initialDescription,
  lang,
  image,
  imageAlt,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
  jsonLd,
} = Astro.props;

const fallbackTitle = lang === 'vi'
  ? 'KD Labs • Bùi Khương Duy — AI-Native Software & Research Lab'
  : 'KD Labs • Bui Khuong Duy — AI-Native Software & Research Lab';

const fallbackDescription = lang === 'vi'
  ? 'KD Labs là AI-Native Software & Research Lab sáng lập bởi Bùi Khương Duy — nghiên cứu và phát triển phần mềm tích hợp AI Agent, kiến trúc hệ thống phân tán, hạ tầng Cloud-Native Kubernetes (K8s) và các ứng dụng đề cao quyền riêng tư.'
  : 'KD Labs is an AI-Native Software & Research Lab founded by Bui Khuong Duy — building intelligent multi-agent software, distributed systems, Cloud-Native Kubernetes (K8s) infrastructure, and privacy-first applications.';

const title = initialTitle || fallbackTitle;
const description = initialDescription || fallbackDescription;
const authorName = author || (lang === 'vi' ? siteConfig.author.name : siteConfig.author.alternateName);
const keywordsList = tags && tags.length > 0
  ? [...tags, ...siteConfig.keywords[lang]]
  : siteConfig.keywords[lang];

const siteUrl = Astro.site ? Astro.site.origin : 'https://kd.io.vn';
const rootUrl = `${siteUrl}/`;
const rawPathname = Astro.url.pathname;
const pathname = rawPathname.endsWith('/') ? rawPathname : `${rawPathname}/`;
const canonicalURL = new URL(pathname, siteUrl);

const viPath = getLocalizedPath(pathname, 'vi');
const enPath = getLocalizedPath(pathname, 'en');

const viAlternateURL = new URL(viPath, siteUrl);
const enAlternateURL = new URL(enPath, siteUrl);
// Google SEO: x-default fallback points to Vietnamese, the primary language
const xDefaultURL = viAlternateURL;

// Contextual & Localized OG Images
const defaultOgImage = lang === 'vi' 
  ? `${siteUrl}/assets/branding/og-vi.png` 
  : `${siteUrl}/assets/branding/og-en.png`;

let ogImageUrl = defaultOgImage;
if (image) {
  if (image.startsWith('http://') || image.startsWith('https://')) {
    ogImageUrl = image;
  } else {
    ogImageUrl = new URL(image.startsWith('/') ? image : `/${image}`, siteUrl).href;
  }
}

const defaultImageAlt = lang === 'vi'
  ? 'KD Labs • Bùi Khương Duy — AI-Native Developer, Web & Mobile, System Architecture, DevOps/K8s & Research Lab'
  : 'KD Labs • Bui Khuong Duy — AI-Native Developer, Web & Mobile, System Architecture, DevOps/K8s & Research Lab';

const finalImageAlt = imageAlt || (ogType === 'article' ? title : defaultImageAlt);

const ogLocale = lang === 'vi' ? 'vi_VN' : 'en_US';
const ogAlternateLocale = lang === 'vi' ? 'en_US' : 'vi_VN';

// Format published/modified dates
const publishedIso = publishedTime
  ? (typeof publishedTime === 'string' ? new Date(publishedTime).toISOString() : publishedTime.toISOString())
  : undefined;
const modifiedIso = modifiedTime
  ? (typeof modifiedTime === 'string' ? new Date(modifiedTime).toISOString() : modifiedTime.toISOString())
  : undefined;

// Base Person, Organization and WebSite JSON-LD (Google Site Name & Entity Guidelines)
const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': siteConfig.author.id,
      name: siteConfig.author.name,
      alternateName: siteConfig.author.alternateName,
      jobTitle: siteConfig.author.jobTitle,
      description: siteConfig.author.description[lang],
      knowsAbout: siteConfig.author.knowsAbout,
      url: siteConfig.author.url,
      sameAs: siteConfig.author.sameAs,
      worksFor: {
        '@id': `${siteUrl}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'KD Labs',
      alternateName: [
        'KD Labs — AI-Native Labs',
        'KD Labs — AI-Native Software & Research Lab',
      ],
      description: fallbackDescription,
      knowsAbout: siteConfig.author.knowsAbout,
      url: rootUrl,
      foundingDate: siteConfig.foundingDate,
      logo: {
        '@type': 'ImageObject',
        '@id': `${siteUrl}/#logo`,
        url: `${siteUrl}/assets/branding/kd-labs-icon.png`,
        contentUrl: `${siteUrl}/assets/branding/kd-labs-icon.png`,
        width: 512,
        height: 512,
        caption: 'KD Labs Logo',
      },
      founder: {
        '@id': siteConfig.author.id,
      },
      sameAs: [
        siteConfig.googlePlayDevUrl,
        siteConfig.githubUrl,
        siteConfig.twitterUrl,
        siteConfig.linkedinUrl,
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        email: siteConfig.contactEmail,
        contactType: 'customer support',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: rootUrl,
      name: 'KD Labs',
      alternateName: [
        'KD Labs — AI-Native Labs',
        'KD Labs — AI-Native Software & Research Lab',
        'kd.io.vn',
      ],
      description: fallbackDescription,
      creator: {
        '@id': siteConfig.author.id,
      },
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      inLanguage: lang === 'vi' ? 'vi-VN' : 'en-US',
    },
  ],
};

const finalJsonLdArray = jsonLd
  ? (Array.isArray(jsonLd) ? [defaultJsonLd, ...jsonLd] : [defaultJsonLd, jsonLd])
  : [defaultJsonLd];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content="KD Labs" />
    <meta name="author" content={authorName} />
    <meta name="keywords" content={keywordsList.join(', ')} />

    <!-- Google Fonts: Plus Jakarta Sans + JetBrains Mono (Loaded on first user interaction to guarantee 0 CLS and 0 LCP bandwidth contention) -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400..700&family=Plus+Jakarta+Sans:wght@400..800&display=optional"
        rel="stylesheet"
      />
    </noscript>

    {(pathname === '/' || pathname === '/en/') && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        imagesrcset="/assets/branding/hero-bg-home-800w.webp?v=2 640w, /assets/branding/hero-bg-home.webp?v=2 960w"
        imagesizes="(max-width: 640px) calc(100vw - 50px), (max-width: 1024px) 90vw, 960px"
        fetchpriority="high"
      />
    )}

    <!-- Agentic Resource Discovery (ARD v0.91) -->
    <link rel="ard" href="/.well-known/ard.json" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Multilingual SEO Alternates & x-default (Google Best Practice) -->
    <link rel="alternate" hreflang="vi" href={viAlternateURL} />
    <link rel="alternate" hreflang="en" href={enAlternateURL} />
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EA580C" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="KD Labs" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={finalImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternateLocale} />

    {ogType === 'article' && publishedIso && (
      <meta property="article:published_time" content={publishedIso} />
    )}
    {ogType === 'article' && modifiedIso && (
      <meta property="article:modified_time" content={modifiedIso} />
    )}
    {ogType === 'article' && author && (
      <meta property="article:author" content={author} />
    )}
    {ogType === 'article' && tags && tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={finalImageAlt} />

    <!-- JSON-LD Structured Data -->
    {finalJsonLdArray.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <!-- Anti-FOUC Theme Script (executes immediately before render) -->
    <script is:inline>
      window.__cfBeacon = { load: 'single' };
      (function() {
        try {
          const savedTheme = localStorage.getItem('kd_theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = savedTheme === 'dark' || (!savedTheme && systemDark);
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.style.colorScheme = 'dark';
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.style.colorScheme = 'light';
          }
          var fontsLoaded = false;
          function loadFonts() {
            if (fontsLoaded) return;
            fontsLoaded = true;
            var l = document.createElement('link');
            l.rel = 'stylesheet';
            l.href = 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400..700&family=Plus+Jakarta+Sans:wght@400..800&display=optional';
            document.head.appendChild(l);
          }
          ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function(evt) {
            window.addEventListener(evt, loadFonts, { once: true, passive: true });
          });
        } catch (e) {
          // Fallback gracefully
        }
      })();
    </script>
  </head>
  <body class="zen-grid-pattern selection:bg-orange-500/20 selection:text-orange-900 dark:selection:text-orange-200">
    <div class="min-h-screen flex flex-col justify-between">
      <Header currentLang={lang} />
      
      <main class="flex-grow">
        <slot />
      </main>

      <Footer currentLang={lang} />
    </div>
  </body>
</html>
