---
import type { AppItem } from '../data/apps';
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';

interface Props {
  app: AppItem;
  currentLang: Locale;
}

const { app, currentLang } = Astro.props;
const isVi = currentLang === 'vi';
const t = getTranslations(currentLang);
const detailUrl = isVi ? `/apps/${app.slug}/` : `/${currentLang}/apps/${app.slug}/`;
const featureGraphic = app.featureGraphic ? app.featureGraphic[currentLang] : null;
---

<div class="group relative rounded-[2rem] craft-card craft-card-interactive craft-stack p-5 sm:p-8 lg:p-9">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
    
    <!-- Left Column: Product Information & CTA (7 cols) -->
    <div class="lg:col-span-7 space-y-5">
      
      <!-- Top Badges & Meta -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
          {app.status === 'open_source'
            ? (isVi ? 'Mã nguồn mở MIT' : 'MIT Open Source')
            : t.showcase.releasedBadge}
        </span>
        
        <span class="px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap bg-stone-100 dark:bg-stone-800/80 text-stone-600 dark:text-stone-300 border border-stone-200/70 dark:border-stone-700/60">
          {app.category[currentLang]}
        </span>

        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium whitespace-nowrap bg-orange-50 dark:bg-orange-950/40 text-orange-800 dark:text-orange-300 border border-orange-200/60 dark:border-orange-900/40">
          <svg class="w-3.5 h-3.5 fill-none stroke-current shrink-0" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>{app.securityBadge[currentLang]}</span>
        </span>

        {app.version && (
          <span class="text-xs text-stone-500 dark:text-stone-400 font-mono whitespace-nowrap">
            v{app.version}
          </span>
        )}
      </div>

      <!-- Product Header: Icon + Title -->
      <div class="flex items-center gap-4">
        {app.iconImage ? (
          <picture class="flex-shrink-0">
            {app.iconImage.endsWith('.png') && (
              <source type="image/webp" srcset={app.iconImage.replace(/\.png$/, '.webp')} />
            )}
            <img
              src={app.iconImage}
              alt={`${app.name} Icon`}
              width="64"
              height="64"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              class="w-15 h-15 sm:w-16 sm:h-16 rounded-2xl object-cover shadow-md shadow-orange-500/15 flex-shrink-0 border border-stone-200 dark:border-stone-800"
            />
          </picture>
        ) : (
          <div class="w-15 h-15 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-br from-orange-500 to-orange-700 flex items-center justify-center text-white shadow-md shadow-orange-500/20 flex-shrink-0">
            <svg class="w-8 h-8 sm:w-9 sm:h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
        )}

        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-xl sm:text-2xl font-bold text-stone-900 dark:text-stone-100 tracking-tight group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
              <a href={detailUrl} class="focus:outline-none">
                {app.name}
              </a>
            </h3>
            <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 border border-stone-200/70 dark:border-stone-700/60">
              {app.platformBadge}
            </span>
          </div>
          <p class="text-xs font-mono text-stone-500 dark:text-stone-400 mt-0.5">
            {app.packageName}
          </p>
        </div>
      </div>

      <!-- Short Description -->
      <p class="text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
        {app.shortDescription[currentLang]}
      </p>

      <!-- Craft Block Key Features Grid -->
      <div class="space-y-2.5 pt-1">
        <h4 class="text-[11px] font-mono uppercase tracking-wider font-semibold text-stone-500 dark:text-stone-400">
          {t.showcase.featuresHeading}
        </h4>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-stone-700 dark:text-stone-300">
          {app.features[currentLang].slice(0, 4).map((feature) => {
            const colonIndex = feature.indexOf(':');
            const hasLabel = colonIndex > 0;
            const label = hasLabel ? feature.slice(0, colonIndex + 1) : '';
            const desc = hasLabel ? feature.slice(colonIndex + 1).trim() : feature;

            return (
              <li class="flex items-start gap-2 p-2.5 rounded-xl bg-stone-50/90 dark:bg-stone-900/50 border border-stone-200/60 dark:border-stone-800/70">
                <svg class="w-4 h-4 text-orange-600 dark:text-orange-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                {hasLabel ? (
                  <span class="leading-snug">
                    <strong class="font-semibold text-stone-900 dark:text-stone-100">{label}</strong>{' '}
                    <span class="text-stone-600 dark:text-stone-300">{desc}</span>
                  </span>
                ) : (
                  <span class="leading-snug">{feature}</span>
                )}
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Craft Pill CTA Action Row -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 pt-2 sm:pt-3">
        {/* Primary CTA for Mobile App: App Store */}
        {app.appStoreUrl && (
          <a
            href={app.appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-5 py-3 sm:py-2.5 rounded-full bg-orange-600 hover:bg-orange-700 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-orange-600/20 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99] whitespace-nowrap"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.06 1.71-.93 2.73.99.08 2.02-.48 2.63-1.23z"/>
            </svg>
            <span>{t.showcase.getOnAppStore}</span>
          </a>
        )}

        {/* Primary CTA for VS Code Extension: Marketplace */}
        {app.vsMarketplaceUrl && (
          <a
            href={app.vsMarketplaceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-5 py-3 sm:py-2.5 rounded-full bg-orange-600 hover:bg-orange-700 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-orange-600/20 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99] whitespace-nowrap"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            <span>VS Code Marketplace</span>
          </a>
        )}

        {app.openVsxUrl && (
          <a
            href={app.openVsxUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-5 py-3 sm:py-2.5 rounded-full bg-orange-600 hover:bg-orange-700 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-orange-600/20 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99] whitespace-nowrap"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            <span>Open VSX</span>
          </a>
        )}

        {/* Primary CTA for VS Code Extension: GitHub Repository */}
        {!app.appStoreUrl && !app.vsMarketplaceUrl && !app.openVsxUrl && app.githubUrl && (
          <a
            href={app.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-5 py-3 sm:py-2.5 rounded-full bg-orange-600 hover:bg-orange-700 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-orange-600/20 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99] whitespace-nowrap"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>{isVi ? 'Mã nguồn trên GitHub' : 'Source on GitHub'}</span>
          </a>
        )}

        {/* Secondary GitHub Button when App Store / Marketplace is primary */}
        {(app.appStoreUrl || app.vsMarketplaceUrl || app.openVsxUrl) && app.githubUrl && (
          <a
            href={app.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full border border-stone-200 dark:border-stone-700 bg-stone-100/80 dark:bg-stone-800/80 hover:bg-stone-200/80 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 text-xs sm:text-sm font-medium transition-colors whitespace-nowrap"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>
        )}

        {/* Protocol Link for KD Code */}
        {app.protocolUrl && (
          <a
            href={app.protocolUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full border border-stone-200 dark:border-stone-700 bg-stone-100/80 dark:bg-stone-800/80 hover:bg-stone-200/80 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 text-xs sm:text-sm font-medium transition-colors whitespace-nowrap"
          >
            <span>ACP Spec</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}

        <!-- View Details Page Button -->
        <a
          href={detailUrl}
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full border border-stone-200 dark:border-stone-700 hover:border-orange-500 text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 text-xs sm:text-sm font-medium transition-colors whitespace-nowrap"
        >
          <span>{t.showcase.viewDetails}</span>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>

    <!-- Right Column: Craft Window Visual Showcase (5 cols) -->
    <div class="lg:col-span-5 flex justify-center">
      {app.id === 'kd-code' ? (
        <div data-nosnippet class="w-full rounded-2xl overflow-hidden craft-window text-stone-100 p-4 sm:p-5 space-y-3.5 font-mono text-xs group-hover:border-orange-500/40 transition-all duration-300">
          <!-- Window Top Bar -->
          <div class="flex items-center justify-between gap-2 pb-3 border-b border-white/10">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F56] shrink-0"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E] shrink-0"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F] shrink-0"></span>
              <span class="ml-1.5 text-[11px] font-bold text-stone-200 truncate">KD Code • Secondary Sidebar</span>
            </div>
            <span class="shrink-0 px-2 py-0.5 rounded-md bg-orange-500/15 text-orange-400 border border-orange-500/30 text-[10px]">
              Cmd+Alt+A
            </span>
          </div>

          <!-- Active Agent & Worktree Selector -->
          <div class="p-3 rounded-xl bg-white/[0.04] border border-white/10 space-y-2">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-stone-400">ACP Agent Registry</span>
              <span class="text-emerald-400 font-semibold">● 3 Agents Ready</span>
            </div>
            <div class="flex flex-wrap gap-1.5 text-[10px]">
              <span class="px-2 py-0.5 rounded bg-orange-600 text-white font-semibold">Claude Code</span>
              <span class="px-2 py-0.5 rounded bg-white/10 text-stone-300">Codex</span>
              <span class="px-2 py-0.5 rounded bg-white/10 text-stone-300">OpenCode</span>
              <span class="px-2 py-0.5 rounded bg-white/5 text-stone-400">+MCP</span>
            </div>
          </div>

          <!-- Isolated Git Worktree Diff Preview -->
          <div class="p-3 rounded-xl bg-white/[0.04] border border-orange-500/40 space-y-2">
            <div class="flex items-center justify-between text-[10px]">
              <span class="text-orange-300 font-semibold truncate">⎇ worktree: wt/acp-multi-agent</span>
              <span class="text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-800/50">Best of 3</span>
            </div>
            <div class="rounded-lg bg-black/50 p-2.5 border border-white/10 text-[10px] space-y-1">
              <div class="flex items-center justify-between text-stone-400">
                <span>src/acp/worktreeManager.ts</span>
                <span class="text-emerald-400">+48 −12</span>
              </div>
              <div class="text-emerald-400/90 truncate">+ await spawnIsolatedWorktree(branch, agentId);</div>
              <div class="text-emerald-400/90 truncate">+ await compareAgentDiffs(worktreeGroup);</div>
            </div>
            <div class="flex items-center justify-between pt-1 text-[10px]">
              <span class="text-stone-400">ccusage: 12.4k tok • $0.03</span>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded bg-emerald-600/20 text-emerald-300 border border-emerald-500/30">Keep</span>
                <span class="px-2 py-0.5 rounded bg-white/10 text-stone-300">Merge PR</span>
              </div>
            </div>
          </div>
        </div>
      ) : featureGraphic ? (
        <div class="relative w-full rounded-2xl overflow-hidden craft-window group-hover:border-orange-500/40 transition-all duration-300">
          <picture>
            {featureGraphic.endsWith('.png') && (
              <source
                type="image/webp"
                srcset={`${featureGraphic.replace(/\.png$/, '-600w.webp')} 600w, ${featureGraphic.replace(/\.png$/, '.webp')} 1024w`}
                sizes="(max-width: 640px) calc(100vw - 76px), 420px"
              />
            )}
            <img
              src={featureGraphic}
              alt={`${app.name} Feature Banner`}
              width="1024"
              height="500"
              class="w-full h-auto object-cover transform group-hover:scale-[1.02] transition-transform duration-500"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </picture>
          <div class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-full bg-stone-950/85 backdrop-blur-md text-[10px] font-mono text-stone-200 border border-white/15">
            iOS App Store & Android • 100% Offline
          </div>
        </div>
      ) : (
        <div class="w-full max-w-[300px] rounded-3xl p-3 bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-md">
          <div class="rounded-2xl bg-stone-950 p-6 text-stone-100 flex flex-col justify-center items-center aspect-[9/16]">
            <span class="text-4xl">🔒</span>
            <span class="text-base font-bold mt-2">{app.name}</span>
          </div>
        </div>
      )}
    </div>

  </div>

</div>
