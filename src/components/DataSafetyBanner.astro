---
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = getTranslations(currentLang);
---

<section class="py-16 bg-stone-100/60 dark:bg-stone-900/40 border-y border-stone-200/80 dark:border-stone-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161412] p-8 sm:p-12 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Summary & CTA (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            {t.dataSafety.tagline}
          </span>

          <h3 class="text-2xl sm:text-3xl font-bold text-stone-900 dark:text-stone-100 tracking-tight">
            {t.dataSafety.title}
          </h3>

          <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
            {t.dataSafety.subtitle}
          </p>

          <div class="pt-2">
            <a
              href={currentLang === 'vi' ? '/privacy' : `/${currentLang}/privacy`}
              class="inline-flex items-center gap-2 text-sm font-semibold text-orange-600 dark:text-orange-500 hover:text-orange-700 dark:hover:text-orange-400 group"
            >
              <span>{t.dataSafety.readPolicyCta}</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: 3 Key Commitments (7 cols) -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-6">
          
          <div class="space-y-2 p-4 rounded-2xl bg-stone-50 dark:bg-stone-900/60 border border-stone-200/60 dark:border-stone-800/60">
            <div class="w-8 h-8 rounded-lg bg-orange-500/10 text-orange-600 dark:text-orange-500 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h4 class="text-sm font-bold text-stone-900 dark:text-stone-100">
              {t.dataSafety.point1Title}
            </h4>
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
              {t.dataSafety.point1Desc}
            </p>
          </div>

          <div class="space-y-2 p-4 rounded-2xl bg-stone-50 dark:bg-stone-900/60 border border-stone-200/60 dark:border-stone-800/60">
            <div class="w-8 h-8 rounded-lg bg-orange-500/10 text-orange-600 dark:text-orange-500 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h4 class="text-sm font-bold text-stone-900 dark:text-stone-100">
              {t.dataSafety.point2Title}
            </h4>
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
              {t.dataSafety.point2Desc}
            </p>
          </div>

          <div class="space-y-2 p-4 rounded-2xl bg-stone-50 dark:bg-stone-900/60 border border-stone-200/60 dark:border-stone-800/60">
            <div class="w-8 h-8 rounded-lg bg-orange-500/10 text-orange-600 dark:text-orange-500 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
              </svg>
            </div>
            <h4 class="text-sm font-bold text-stone-900 dark:text-stone-100">
              {t.dataSafety.point3Title}
            </h4>
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
              {t.dataSafety.point3Desc}
            </p>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
