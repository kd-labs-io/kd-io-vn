---
import type { Locale } from '../data/i18n';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;

const items = currentLang === 'vi'
  ? [
      {
        slideIndex: 0,
        title: 'AI-Native',
        desc: 'Tự động hóa quy trình với Multi-Agent, LLM & kiến trúc thông minh.',
        icon: 'M13 10V3L4 14h7v7l9-11h-7z',
      },
      {
        slideIndex: 1,
        title: 'Web Apps',
        desc: 'Nền tảng Web siêu tốc (Edge SSR/SSG), chuẩn 100/100 Web Vitals & SEO.',
        icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
      },
      {
        slideIndex: 2,
        title: 'Mobile Apps',
        desc: 'Ứng dụng đa nền tảng, kiến trúc Local-First & bảo mật phần cứng.',
        icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
      },
      {
        slideIndex: 3,
        title: 'System Design',
        desc: 'Kiến trúc hệ thống phân tán, Event-Driven, chịu tải cao & chống lỗi.',
        icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
      },
      {
        slideIndex: 4,
        title: 'DevOps & K8s',
        desc: 'Điều phối container Kubernetes, GitOps CI/CD & Cloud-Native 99.99%.',
        icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
      },
      {
        slideIndex: 5,
        title: 'R&D',
        desc: 'Nghiên cứu chuyên sâu về Mật mã học, Zero-Knowledge, FIDO2 & AI.',
        icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
      },
    ]
  : [
      {
        slideIndex: 0,
        title: 'AI-Native',
        desc: 'Multi-Agent workflows, LLM orchestration & intelligent systems.',
        icon: 'M13 10V3L4 14h7v7l9-11h-7z',
      },
      {
        slideIndex: 1,
        title: 'Web Apps',
        desc: 'Ultra-fast Edge SSR/SSG platforms, 100/100 Web Vitals & Tech SEO.',
        icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
      },
      {
        slideIndex: 2,
        title: 'Mobile Apps',
        desc: 'Cross-platform mobile apps with local-first & hardware-grade security.',
        icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
      },
      {
        slideIndex: 3,
        title: 'System Design',
        desc: 'Distributed systems, Event-Driven meshes & fault-tolerant scale.',
        icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
      },
      {
        slideIndex: 4,
        title: 'DevOps & K8s',
        desc: 'Kubernetes cluster orchestration, GitOps CI/CD & 99.99% infra.',
        icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
      },
      {
        slideIndex: 5,
        title: 'R&D',
        desc: 'Deep-tech research in Cryptography, Zero-Knowledge, FIDO2 & AI.',
        icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
      },
    ];
---

<div class="border-y border-stone-200/80 dark:border-stone-800/80 bg-stone-100/50 dark:bg-stone-900/40 backdrop-blur-sm py-6 sm:py-8 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 lg:gap-8">
      {items.map((item) => (
        <button
          type="button"
          data-jump-slide={item.slideIndex}
          class="flex flex-col sm:flex-row items-start gap-2.5 sm:gap-3.5 text-left group cursor-pointer rounded-2xl p-3.5 sm:p-2.5 sm:-m-2.5 bg-white/75 dark:bg-stone-900/60 sm:bg-transparent border border-stone-200/80 dark:border-stone-800/80 sm:border-0 hover:bg-stone-200/50 dark:hover:bg-stone-800/40 active:scale-[0.98] transition-all shadow-2xs sm:shadow-none"
        >
          <div class="flex-shrink-0 w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-orange-500/10 dark:bg-orange-500/15 border border-orange-500/25 group-hover:bg-orange-600 group-hover:text-white flex items-center justify-center text-orange-600 dark:text-orange-500 transition-colors">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold sm:font-semibold text-stone-900 dark:text-stone-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
              {item.title}
            </h3>
            <p class="text-[11px] sm:text-xs text-stone-600 dark:text-stone-300 mt-0.5 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </button>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const jumpBtns = document.querySelectorAll('[data-jump-slide]');
    jumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-jump-slide');
        const targetTab = document.querySelector(`[data-slide-target="${idx}"]`);
        if (targetTab) {
          targetTab.click();
          const hero = document.getElementById('hero-slider-section');
          if (hero) {
            hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  })();
</script>
