---
import type { Locale } from '../data/i18n';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;

const items = currentLang === 'vi'
  ? [
      {
        slideIndex: 0,
        title: 'AI-Native Engineering',
        desc: 'Tự động hóa quy trình với Multi-Agent, LLM & kiến trúc thông minh.',
        icon: 'M13 10V3L4 14h7v7l9-11h-7z',
      },
      {
        slideIndex: 2,
        title: 'Web & Hệ thống Phân tán',
        desc: 'Nền tảng Web siêu tốc (Edge SSR/SSG) & System Architecture chịu tải cao.',
        icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
      },
      {
        slideIndex: 3,
        title: 'DevOps & Kubernetes (K8s)',
        desc: 'Điều phối container K8s, GitOps CI/CD & hạ tầng Cloud-Native 99.99%.',
        icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
      },
      {
        slideIndex: 1,
        title: 'Mobile & Bảo mật Phần cứng',
        desc: 'Ứng dụng 100% ngoại tuyến, mã hóa AES-256-GCM & nghiên cứu R&D.',
        icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
      },
    ]
  : [
      {
        slideIndex: 0,
        title: 'AI-Native Engineering',
        desc: 'Multi-Agent workflows, LLM orchestration & intelligent systems.',
        icon: 'M13 10V3L4 14h7v7l9-11h-7z',
      },
      {
        slideIndex: 2,
        title: 'Web & System Design',
        desc: 'Ultra-fast Edge Web platforms & high-throughput distributed systems.',
        icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
      },
      {
        slideIndex: 3,
        title: 'DevOps & Kubernetes (K8s)',
        desc: 'K8s cluster orchestration, GitOps CI/CD & 99.99% Cloud-Native infra.',
        icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
      },
      {
        slideIndex: 1,
        title: 'Mobile & Hardware Security',
        desc: '100% offline apps, AES-256-GCM hardware enclaves & deep-tech R&D.',
        icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
      },
    ];
---

<div class="border-y border-stone-200/80 dark:border-stone-800/80 bg-stone-100/50 dark:bg-stone-900/40 backdrop-blur-sm py-8 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
      {items.map((item) => (
        <button
          type="button"
          data-jump-slide={item.slideIndex}
          class="flex items-start gap-3.5 text-left group cursor-pointer rounded-2xl p-2 -m-2 hover:bg-stone-200/50 dark:hover:bg-stone-800/40 transition-colors"
        >
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-orange-500/10 dark:bg-orange-500/15 border border-orange-500/25 group-hover:bg-orange-600 group-hover:text-white flex items-center justify-center text-orange-600 dark:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-stone-900 dark:text-stone-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
              {item.title}
            </h3>
            <p class="text-xs text-stone-600 dark:text-stone-300 mt-0.5 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </button>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const jumpBtns = document.querySelectorAll('[data-jump-slide]');
    jumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-jump-slide');
        const targetTab = document.querySelector(`[data-slide-target="${idx}"]`);
        if (targetTab) {
          targetTab.click();
          const hero = document.getElementById('hero-slider-section');
          if (hero) {
            hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  })();
</script>
