                </div>
                <div>
                  <span class="block text-stone-400 dark:text-stone-500">Format</span>
                  <span class="font-semibold text-stone-700 dark:text-stone-300">{app.format}</span>
                </div>
              </div>

              <!-- Download Button -->
              <div>
                <a
                  href={app.pngUrl}
                  download
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-stone-900 text-stone-100 dark:bg-stone-100 dark:text-stone-900 hover:bg-orange-600 dark:hover:bg-orange-500 dark:hover:text-white transition-colors shadow-xs"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  <span>{b.appIcons.downloadPng}</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- MODULE 7: Usage Guidelines (Do's and Don'ts) -->
    <section id="guidelines" class="space-y-8">
      <div class="border-b border-stone-200 dark:border-stone-800 pb-5">
        <span class="text-xs font-bold tracking-widest text-orange-600 dark:text-orange-400 uppercase">
          {b.guidelines.tagline}
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 dark:text-stone-100 mt-1">
          {b.guidelines.title}
        </h2>
        <p class="text-sm text-stone-600 dark:text-stone-400 mt-2 max-w-2xl">
          {b.guidelines.subtitle}
        </p>
      </div>

      <!-- Clear Space Highlight Box -->
      <div class="rounded-3xl p-5 sm:p-8 bg-white dark:bg-[#161412] border border-stone-200 dark:border-stone-800 shadow-sm flex flex-col md:flex-row items-center gap-6 sm:gap-8">
        <div class="w-full md:w-1/2 p-6 rounded-2xl bg-stone-100/70 dark:bg-stone-900/50 border border-dashed border-orange-500/50 flex flex-col items-center justify-center relative">
          <span class="absolute top-2 left-3 text-[10px] font-mono text-orange-600 dark:text-orange-400 font-bold">Clear Space: 1X (X = K-height)</span>
          <div class="p-6 border border-stone-300 dark:border-stone-700 rounded-xl bg-white dark:bg-[#181614] shadow-xs">
            <img
              src="/assets/press/kd-labs-logo-horizontal-dark.svg"
              alt="KD Labs Logo Clear Space"
              class="h-12 w-auto dark:hidden"
            />
            <img
              src="/assets/press/kd-labs-logo-horizontal-light.svg"
              alt="KD Labs Logo Clear Space"
              class="h-12 w-auto hidden dark:block"
            />
