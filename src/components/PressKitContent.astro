        <div class="w-full md:w-1/2 space-y-3">
          <h3 class="text-lg font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-orange-500"></span>
            {b.guidelines.clearSpaceTitle}
