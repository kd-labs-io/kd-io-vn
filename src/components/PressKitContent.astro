<!-- Global Toast Notification -->
<div
  id="press-toast"
  class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 shadow-xl text-xs font-semibold"
>
  <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
  </svg>
  <span id="press-toast-msg">Đã sao chép!</span>
</div>

<script is:inline>
  function setupPressInteractions() {
    const toast = document.getElementById('press-toast');
    const toastMsg = document.getElementById('press-toast-msg');

    function showToast(message) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 2400);
    }

    // Color Swatch 1-Click Copy
    document.querySelectorAll('.color-copy-card').forEach((card) => {
      card.addEventListener('click', async () => {
        const hex = card.getAttribute('data-color-hex');
        if (!hex) return;
        try {
          await navigator.clipboard.writeText(hex);
          showToast(`Copied ${hex}`);
        } catch (e) {
          // Fallback
        }
      });
    });

    // Copy SVG Code
    document.querySelectorAll('.copy-svg-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const svgUrl = btn.getAttribute('data-copy-svg-url');
        if (!svgUrl) return;
        try {
          const res = await fetch(svgUrl);
          const svgText = await res.text();
          await navigator.clipboard.writeText(svgText);
          showToast('SVG Markup Copied!');
        } catch (e) {
          showToast('Could not copy SVG');
        }
      });
    });

    // Copy Boilerplate Text
    const copyBoilerplateBtn = document.getElementById('copy-boilerplate-btn');
    if (copyBoilerplateBtn) {
      copyBoilerplateBtn.addEventListener('click', async () => {
        const text = copyBoilerplateBtn.getAttribute('data-boilerplate-text');
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          showToast('Boilerplate Copied!');
        } catch (e) {
          // Fallback
        }
      });
    }

    // Copy Press Email
    const copyPressEmailBtn = document.getElementById('copy-press-email-btn');
    if (copyPressEmailBtn) {
      copyPressEmailBtn.addEventListener('click', async () => {
        const email = copyPressEmailBtn.getAttribute('data-email');
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          showToast(`Copied ${email}`);
        } catch (e) {
          // Fallback
        }
      });
    }
  }

  setupPressInteractions();
  document.addEventListener('astro:after-swap', setupPressInteractions);
</script>
