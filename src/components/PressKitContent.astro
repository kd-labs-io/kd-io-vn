      <!-- Do's and Don'ts Columns -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        <!-- DO'S -->
        <div class="rounded-3xl p-5 sm:p-8 bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200/80 dark:border-emerald-900/40 space-y-5">
