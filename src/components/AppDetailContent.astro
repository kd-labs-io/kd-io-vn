---
import type { AppItem } from '../data/apps';
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';

interface Props {
  app: AppItem;
  currentLang: Locale;
}

const { app, currentLang } = Astro.props;
const isVi = currentLang === 'vi';
const t = getTranslations(currentLang);
const screenshots = app.screenshots ? app.screenshots[currentLang] : [];
const featureGraphic = app.featureGraphic ? app.featureGraphic[currentLang] : null;
const isVsCodeExt = app.platformType === 'vscode_extension';
const homeShowcaseUrl = isVi ? '/#showcase' : `/${currentLang}/#showcase`;
const privacyUrl = isVi ? '/privacy/' : `/${currentLang}/privacy/`;
const researchBlogUrl = app.researchBlogSlug
  ? (isVi ? `/blog/${app.researchBlogSlug}/` : `/${currentLang}/blog/${app.researchBlogSlug}/`)
  : null;

const releaseNotes = app.whatsNew
  ? app.whatsNew[currentLang]
      .split('\n')
      .map((line) => line.replace(/^[•\-]\s*/, '').trim())
      .filter(Boolean)
  : [];

const quickInstallCmd = app.packageName ? `code --install-extension ${app.packageName}` : null;
---

<div class="relative overflow-x-clip pt-6 sm:pt-10 pb-16 sm:pb-24">
  <!-- Subtle Craft Ambient Aura behind hero -->
  <div
    class="absolute top-16 left-1/2 -translate-x-1/2 w-[520px] h-[420px] sm:w-[860px] sm:h-[520px] rounded-full zen-circle-gradient pointer-events-none -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">

    <!-- Top Breadcrumb Row -->
    <div class="flex items-center justify-between gap-4">
      <a
        href={homeShowcaseUrl}
        class="group inline-flex items-center gap-2 px-4 py-2 rounded-full craft-card text-xs font-semibold text-stone-700 dark:text-stone-200 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-500/50 transition-all"
      >
        <svg
          class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-x-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{t.appDetail.backToApps}</span>
      </a>

      <nav aria-label="Breadcrumb" class="hidden sm:flex items-center gap-2 text-xs font-mono text-stone-500 dark:text-stone-400">
        <span>KD Labs</span>
        <span class="text-stone-300 dark:text-stone-700" aria-hidden="true">/</span>
        <span>{t.nav.apps}</span>
        <span class="text-stone-300 dark:text-stone-700" aria-hidden="true">/</span>
        <span class="text-stone-800 dark:text-stone-200 font-semibold">{app.name}</span>
      </nav>
    </div>

    <!-- Flagship Product Hero Card -->
    <section class="rounded-[2rem] craft-card craft-stack p-6 sm:p-8 lg:p-10">
      <!-- Subtle warm corner glow clipped inside its own inner overlay so .craft-stack::before is unaffected -->
      <div class="pointer-events-none absolute inset-0 rounded-[2rem] overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-orange-500/[0.07] dark:bg-orange-500/[0.12] blur-3xl"></div>
      </div>

      <!-- Upper Section: Identity & Short Description -->
      <div class="relative flex flex-col sm:flex-row items-start gap-5 sm:gap-7">
        <!-- Product Icon -->
        {app.iconImage ? (
          <picture class="shrink-0">
            {app.iconImage.endsWith('.png') && (
              <source type="image/webp" srcset={app.iconImage.replace(/\.png$/, '.webp')} />
            )}
            <img
              src={app.iconImage}
              alt={`${app.name} Icon`}
              width="96"
              height="96"
              fetchpriority="high"
              decoding="async"
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-[1.5rem] sm:rounded-[1.75rem] object-cover shadow-xl shadow-orange-500/15 border border-stone-200/80 dark:border-stone-700/80 shrink-0"
            />
          </picture>
        ) : (
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-[1.5rem] sm:rounded-[1.75rem] bg-gradient-to-br from-orange-500 to-orange-700 flex items-center justify-center text-white shadow-xl shadow-orange-500/20 shrink-0">
            <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
        )}

        <!-- Metadata, Title & Pitch -->
        <div class="flex-1 min-w-0 space-y-3">
          <!-- Badge Strip -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap bg-orange-50 dark:bg-orange-950/50 text-orange-700 dark:text-orange-300 border border-orange-200/80 dark:border-orange-800/60">
              {app.category[currentLang]}
            </span>

            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800/60">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span>{app.securityBadge[currentLang]}</span>
            </span>

            {app.version && (
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-mono font-medium whitespace-nowrap bg-stone-100 dark:bg-stone-800/90 text-stone-600 dark:text-stone-300 border border-stone-200/80 dark:border-stone-700/70">
                v{app.version} • MIT
              </span>
            )}
          </div>

          <!-- Title & Publisher Row -->
          <div class="space-y-1.5">
            <h1 class="text-3xl sm:text-4xl lg:text-[2.5rem] font-extrabold tracking-tight text-stone-900 dark:text-stone-100 leading-[1.12]">
              {app.name}
            </h1>
            <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs sm:text-sm text-stone-500 dark:text-stone-400">
              <span class="font-medium text-stone-700 dark:text-stone-300">KD Labs (@kd-labs-io)</span>
              {app.packageName && (
                <>
                  <span class="text-stone-300 dark:text-stone-700" aria-hidden="true">•</span>
                  <code class="font-mono text-xs text-stone-600 dark:text-stone-300 bg-stone-100/90 dark:bg-stone-800/80 px-2 py-0.5 rounded-md border border-stone-200/70 dark:border-stone-700/70">
                    {app.packageName}
                  </code>
                </>
              )}
              <span class="hidden sm:inline text-stone-300 dark:text-stone-700" aria-hidden="true">•</span>
              <span class="hidden sm:inline text-xs text-stone-500 dark:text-stone-400">{app.platformBadge}</span>
            </div>
          </div>

          <!-- Short Description -->
          <p class="text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed max-w-3xl text-pretty pt-0.5">
            {app.shortDescription[currentLang]}
          </p>
        </div>
      </div>

      <!-- Lower Section: Unified Craft Pill Action Bar -->
      <div class="relative mt-6 pt-5 sm:pt-6 border-t border-stone-200/80 dark:border-stone-800/80 flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center justify-between gap-3">
        <!-- Left Cluster: Install & Source -->
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5">
          {app.appStoreUrl && (
            <a
              href={app.appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 px-6 py-2.5 sm:py-3 rounded-full bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md shadow-orange-600/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.99] whitespace-nowrap"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.06 1.71-.93 2.73.99.08 2.02-.48 2.63-1.23z"/>
              </svg>
              <span>{t.appDetail.downloadOnAppStore}</span>
            </a>
          )}

          {app.vsMarketplaceUrl && (
            <a
              href={app.vsMarketplaceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-full bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md shadow-orange-600/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.99] whitespace-nowrap"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>VS Code Marketplace</span>
            </a>
          )}

          {app.openVsxUrl && (
            <a
              href={app.openVsxUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:py-3 rounded-full bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md shadow-orange-600/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.99] whitespace-nowrap"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Open VSX</span>
            </a>
          )}

          {app.githubUrl && (
            <a
              href={app.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:py-3 rounded-full font-semibold text-sm transition-all duration-200 hover:-translate-y-0.5 whitespace-nowrap ${
                !app.appStoreUrl && !app.vsMarketplaceUrl && !app.openVsxUrl
                  ? 'bg-orange-600 hover:bg-orange-700 text-white shadow-md shadow-orange-600/20 active:scale-[0.99]'
                  : 'border border-stone-300/90 dark:border-stone-700 bg-white dark:bg-stone-800/90 hover:border-stone-400 dark:hover:border-stone-500 text-stone-800 dark:text-stone-100 shadow-2xs'
              }`}
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>{t.appDetail.viewGithub}</span>
            </a>
          )}
        </div>

        <!-- Right Spec / Protocol Link -->
        {app.protocolUrl && (
          <a
            href={app.protocolUrl}
            target="_blank"
            rel="noopener noreferrer"
            title="Agent Client Protocol (ACP)"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 sm:py-3 rounded-full border border-stone-200/90 dark:border-stone-800 bg-stone-100/80 dark:bg-stone-900/80 hover:border-orange-500/40 hover:text-orange-600 dark:hover:text-orange-400 text-stone-600 dark:text-stone-300 font-medium text-xs sm:text-sm transition-all whitespace-nowrap"
          >
            <span>{isVi ? 'Chuẩn giao thức ACP' : 'ACP Protocol Spec'}</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>
    </section>

    <!-- Framed Feature Graphic Banner if available -->
    {featureGraphic && (
      <div class="rounded-[2rem] craft-card p-2 sm:p-3">
        <div class="rounded-[1.4rem] sm:rounded-[1.6rem] overflow-hidden bg-stone-950">
          <picture>
            {featureGraphic.endsWith('.png') && (
              <source type="image/webp" srcset={featureGraphic.replace(/\.png$/, '.webp')} />
            )}
            <img
              src={featureGraphic}
              alt={`${app.name} Feature Graphic`}
              width="1024"
              height="500"
              decoding="async"
              class="w-full h-auto object-cover"
            />
          </picture>
        </div>
      </div>
    )}

    <!-- VS Code Extension Architecture & Interactive Quick-Install Window -->
    {isVsCodeExt && (
      <section class="rounded-[2rem] craft-window text-stone-100 p-6 sm:p-8 space-y-6">
        <!-- Window Top Chrome -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-white/10">
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F56] shrink-0"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E] shrink-0"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F] shrink-0"></span>
            <span class="ml-1.5 text-xs sm:text-sm font-mono font-bold text-stone-100 truncate">
              {isVi
                ? 'Kiến trúc Điều phối Agent Client Protocol (ACP) & Git Worktrees'
                : 'Agent Client Protocol (ACP) & Git Worktree Orchestration Architecture'}
            </span>
          </div>
          <span class="text-xs font-mono px-3 py-1 rounded-full bg-orange-500/15 text-orange-300 border border-orange-500/30 shrink-0">
            VS Code Secondary Sidebar • Cmd+Alt+A
          </span>
        </div>

        <!-- Quick CLI Install Bar with 1-Click Copy -->
        {quickInstallCmd && (
          <div class="p-3.5 sm:p-4 rounded-2xl bg-black/45 border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="min-w-0 space-y-1">
              <span class="block text-[11px] font-mono text-stone-400">
                {isVi
                  ? 'Cài đặt nhanh qua Terminal (VS Code / Cursor CLI):'
                  : 'Quick Install via Terminal (VS Code / Cursor CLI):'}
              </span>
              <code class="font-mono text-xs sm:text-sm text-orange-300 font-semibold block overflow-x-auto no-scrollbar whitespace-nowrap">
                <span class="text-stone-500 select-none">$ </span>{quickInstallCmd}
              </code>
            </div>

            <button
              type="button"
              class="kd-copy-btn shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-orange-600 text-stone-100 text-xs font-semibold border border-white/10 transition-colors cursor-pointer"
              data-copy-text={quickInstallCmd}
              data-label-default={isVi ? 'Sao chép' : 'Copy'}
              data-label-copied={isVi ? 'Đã chép ✓' : 'Copied ✓'}
            >
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span class="kd-copy-label">{isVi ? 'Sao chép' : 'Copy'}</span>
            </button>
          </div>
        )}

        <!-- 3-Column Architecture Pipeline -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 space-y-2.5">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-md bg-orange-500/20 text-orange-300 font-mono text-[11px] font-bold border border-orange-500/30">
                01
              </span>
              <h3 class="text-sm font-bold text-stone-100">ACP Registry & Agents</h3>
            </div>
            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
              {isVi
                ? 'Cài đặt 1-click Claude, Codex, OpenCode từ ACP Registry hoặc kết nối Agent cục bộ kèm MCP servers & Skills ($).'
                : 'One-click install of Claude, Codex, and OpenCode from the ACP Registry, or wire custom local agents with MCP servers and Skills ($).'}
            </p>
          </div>

          <div class="p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 space-y-2.5">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-md bg-orange-500/20 text-orange-300 font-mono text-[11px] font-bold border border-orange-500/30">
                02
              </span>
              <h3 class="text-sm font-bold text-stone-100">Isolated Git Worktrees</h3>
            </div>
            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
              {isVi
                ? 'Mỗi phiên hội thoại hoặc tác vụ chạy trên một Git Worktree độc lập, tự động sao chép .env/node_modules và kiểm tra an toàn.'
                : 'Every chat tab executes inside its own dedicated Git worktree and branch, provisioning .env/node_modules with explicit permission gates.'}
            </p>
          </div>

          <div class="p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-emerald-500/35 space-y-2.5">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 font-mono text-[11px] font-bold border border-emerald-500/30">
                03
              </span>
              <h3 class="text-sm font-bold text-emerald-300">Best-of-N Diff & Merge</h3>
            </div>
            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
              {isVi
                ? 'Gửi cùng 1 prompt cho nhiều Agent/Model, đối chiếu diff trực tiếp (Keep/Undo), gộp nhánh hoặc tạo Pull Request qua GitHub CLI.'
                : 'Dispatch one prompt to multiple agents/models in parallel, inspect hunks (Keep/Undo), and merge or draft a Pull Request via GitHub CLI.'}
            </p>
          </div>
        </div>

        <!-- Build from Source Row -->
        {app.installCommand && (
          <div class="p-3.5 sm:p-4 rounded-2xl bg-white/[0.03] border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div class="min-w-0 space-y-1">
              <span class="text-stone-400 block text-[11px] font-mono">
                {isVi
                  ? 'Khởi chạy từ mã nguồn (Yêu cầu VS Code ≥ 1.123):'
                  : 'Build & install from source (Requires VS Code ≥ 1.123):'}
              </span>
              <code class="font-mono text-orange-300 font-semibold block overflow-x-auto no-scrollbar whitespace-nowrap">
                git clone https://github.com/kd-labs-io/kd-code-extension && cd kd-code-extension && {app.installCommand}
              </code>
            </div>
            <span class="self-start sm:self-center shrink-0 text-[11px] font-mono text-emerald-300 bg-emerald-950/60 px-2.5 py-1 rounded-lg border border-emerald-800/50">
              MIT License
            </span>
          </div>
        )}
      </section>
    )}

    <!-- Main Two Column Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Column: Narrative, Features, Screenshots & Release Notes (7 cols) -->
      <div class="lg:col-span-7 space-y-8">

        <!-- About Product Card -->
        <section class="rounded-3xl craft-card p-6 sm:p-8 space-y-3.5">
          <h2 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100 tracking-tight">
            {isVi ? 'Giới thiệu dự án' : 'About the Project'}
          </h2>
          <p class="text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
            {app.fullDescription[currentLang]}
          </p>
        </section>

        <!-- Key Capabilities Card -->
        <section class="rounded-3xl craft-card p-6 sm:p-8 space-y-5">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100 tracking-tight">
              {isVi ? 'Tính năng cốt lõi' : 'Core Capabilities'}
            </h2>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 border border-stone-200/80 dark:border-stone-700/70">
              {app.features[currentLang].length}
            </span>
          </div>

          <div class="space-y-3">
            {app.features[currentLang].map((feature) => {
              const colonIndex = feature.indexOf(':');
              const hasLabel = colonIndex > 0;
              const label = hasLabel ? feature.slice(0, colonIndex + 1) : '';
              const desc = hasLabel ? feature.slice(colonIndex + 1).trim() : feature;

              return (
                <div class="flex items-start gap-3.5 p-3.5 sm:p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-900/55 border border-stone-200/70 dark:border-stone-800/80 hover:border-orange-500/35 transition-colors">
                  <div class="w-6 h-6 rounded-lg bg-orange-500/10 text-orange-600 dark:text-orange-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  {hasLabel ? (
                    <p class="text-sm leading-relaxed">
                      <strong class="font-semibold text-stone-900 dark:text-stone-100">{label}</strong>{' '}
                      <span class="text-stone-600 dark:text-stone-300">{desc}</span>
                    </p>
                  ) : (
                    <span class="text-sm text-stone-700 dark:text-stone-300 font-medium leading-relaxed">
                      {feature}
                    </span>
                  )}
                </div>
              );
            })}
          </div>
        </section>

        <!-- Screenshots Showcase Gallery -->
        {screenshots.length > 0 && (
          <section class="rounded-3xl craft-card p-6 sm:p-8 space-y-5">
            <div class="flex items-center justify-between">
              <h2 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100 tracking-tight">
                {t.appDetail.screenshots}
              </h2>
              <span class="sm:hidden text-xs text-stone-500 dark:text-stone-400">
                {isVi ? 'Vuốt ngang để xem →' : 'Swipe to view →'}
              </span>
            </div>

            <div class="flex sm:grid sm:grid-cols-2 overflow-x-auto snap-x snap-mandatory gap-4 -mx-2 px-2 sm:mx-0 sm:px-0 pb-2 sm:pb-0 no-scrollbar">
              {screenshots.map((shot, idx) => (
                <div class="w-[78%] shrink-0 snap-center sm:w-auto rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800 shadow-md bg-stone-950 group">
                  <img
                    src={shot}
                    alt={`${app.name} Screenshot ${idx + 1}`}
                    class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- What's New / Release Notes Card -->
        {releaseNotes.length > 0 && (
          <section class="rounded-3xl craft-card p-6 sm:p-8 space-y-4">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-sm font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-orange-500"></span>
                <span>{t.appDetail.whatsNew}</span>
              </h3>
              {app.version && (
                <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-orange-50 dark:bg-orange-950/40 text-orange-700 dark:text-orange-400 border border-orange-200/70 dark:border-orange-900/50">
                  v{app.version}
                </span>
              )}
            </div>
            <ul class="space-y-2.5">
              {releaseNotes.map((note) => (
                <li class="flex items-start gap-3 text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
                  <span class="w-1.5 h-1.5 rounded-full bg-orange-500/80 shrink-0 mt-2"></span>
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

      </div>

      <!-- Right Sticky Sidebar: Specs, Security Pledge & Research Deep-Dive (5 cols) -->
      <aside class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">

        <!-- Technical Specifications Card -->
        <div class="rounded-3xl craft-card p-6 sm:p-7 space-y-4">
          <h3 class="text-base font-bold text-stone-900 dark:text-stone-100 border-b border-stone-100 dark:border-stone-800/80 pb-3">
            {t.appDetail.specifications}
          </h3>

          <dl class="divide-y divide-stone-100 dark:divide-stone-800/80 text-xs sm:text-sm">
            <div class="py-3 flex items-start justify-between gap-4">
              <dt class="text-stone-500 dark:text-stone-400 shrink-0">{t.appDetail.packageId}</dt>
              <dd class="font-mono font-medium text-stone-800 dark:text-stone-200 text-right bg-stone-100/80 dark:bg-stone-800/80 px-2 py-0.5 rounded-md border border-stone-200/60 dark:border-stone-700/60">
                {app.packageName}
              </dd>
            </div>

            <div class="py-3 flex items-start justify-between gap-4">
              <dt class="text-stone-500 dark:text-stone-400 shrink-0">{t.showcase.version}</dt>
              <dd class="font-mono font-medium text-stone-800 dark:text-stone-200 text-right">
                v{app.version}
              </dd>
            </div>

            <div class="py-3 flex items-start justify-between gap-4">
              <dt class="text-stone-500 dark:text-stone-400 shrink-0">{t.appDetail.size}</dt>
              <dd class="font-medium text-stone-800 dark:text-stone-200 text-right">{app.size}</dd>
            </div>

            <div class="py-3 flex items-start justify-between gap-4">
              <dt class="text-stone-500 dark:text-stone-400 shrink-0">{t.appDetail.osRequirement}</dt>
              <dd class="font-medium text-stone-800 dark:text-stone-200 text-right">{app.osRequirement}</dd>
            </div>

            <div class="pt-3 pb-1 flex items-start justify-between gap-4">
              <dt class="text-stone-500 dark:text-stone-400 shrink-0">{t.appDetail.lastUpdate}</dt>
              <dd class="font-medium text-stone-800 dark:text-stone-200 text-right">{app.lastUpdated}</dd>
            </div>
          </dl>
        </div>

        <!-- Security & Privacy Pledge Card -->
        <div class="rounded-3xl craft-card p-6 sm:p-7 space-y-3.5 border-emerald-200/80 dark:border-emerald-900/50">
          <div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-semibold text-xs uppercase tracking-wider">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>{t.appDetail.dataProtection}</span>
          </div>

          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
            {app.securityPledge ? app.securityPledge[currentLang] : t.appDetail.dataProtectionText}
          </p>

          <div class="pt-1">
            <a
              href={privacyUrl}
              class="inline-flex items-center gap-1 text-xs font-semibold text-orange-600 dark:text-orange-400 hover:underline"
            >
              <span>
                {isVi ? 'Xem Chính sách quyền riêng tư chi tiết →' : 'Read full Privacy Policy →'}
              </span>
            </a>
          </div>
        </div>

        <!-- Engineering Deep-Dive Research Card -->
        {researchBlogUrl && (
          <a
            href={researchBlogUrl}
            class="group block rounded-3xl craft-card craft-card-interactive p-6 sm:p-7 space-y-3"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-orange-50 dark:bg-orange-950/50 text-orange-700 dark:text-orange-300 border border-orange-200/70 dark:border-orange-800/50">
                {isVi ? 'Nghiên cứu Kỹ thuật (R&D)' : 'Engineering Deep-Dive'}
              </span>
              <svg
                class="w-4 h-4 text-stone-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-transform duration-200 group-hover:translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>

            <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
              {isVi
                ? `Khám phá kiến trúc kỹ thuật chuyên sâu, mô hình bảo mật và triết lý thiết kế đằng sau ${app.name}.`
                : `Explore the architectural design, security model, and engineering decisions behind ${app.name}.`}
            </p>

            <div class="text-xs font-semibold text-orange-600 dark:text-orange-400 group-hover:underline">
              {isVi ? 'Đọc bài viết phân tích kiến trúc →' : 'Read architectural research post →'}
            </div>
          </a>
        )}

      </aside>

    </div>

  </div>
</div>

<script is:inline>
  function setupCopyButtons() {
    document.querySelectorAll('.kd-copy-btn').forEach(function (btn) {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy-text') || '';
        var labelEl = btn.querySelector('.kd-copy-label');
        var defaultLabel = btn.getAttribute('data-label-default') || 'Copy';
        var copiedLabel = btn.getAttribute('data-label-copied') || 'Copied ✓';
        if (!text || !navigator.clipboard) return;

        navigator.clipboard.writeText(text).then(function () {
          if (labelEl) labelEl.textContent = copiedLabel;
          btn.classList.add('bg-emerald-600', 'border-emerald-500/50');
          btn.classList.remove('bg-white/10');
          setTimeout(function () {
            if (labelEl) labelEl.textContent = defaultLabel;
            btn.classList.remove('bg-emerald-600', 'border-emerald-500/50');
            btn.classList.add('bg-white/10');
          }, 1800);
        }).catch(function () {});
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:after-swap', setupCopyButtons);
</script>
