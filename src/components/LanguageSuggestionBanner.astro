---
import type { Locale } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;
const enUrl = getLocalizedPath(currentPath, 'en');
---

{currentLang === 'vi' && (
  <aside
    id="lang-suggestion-banner"
    class="hidden fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:bottom-6 z-50 sm:max-w-md rounded-2xl shadow-2xl transition-opacity transition-transform duration-300 ease-out opacity-0 translate-y-3 border border-orange-700 dark:border-orange-800 bg-orange-600 dark:bg-orange-700 text-white"
    aria-label="Language suggestion"
  >
    <div class="px-4 py-3 sm:p-4">
      <div class="flex flex-col gap-3">
        
        <!-- Top: Globe Icon & Notification Text -->
        <div class="flex items-start gap-3 min-w-0 pr-6">
          <div class="w-7 h-7 rounded-lg bg-white/20 text-white flex items-center justify-center flex-shrink-0 text-sm mt-0.5" aria-hidden="true">
            🌐
          </div>
          <div class="flex flex-col gap-0.5 text-xs leading-relaxed">
            <span class="font-bold text-white">
              Browsing in English?
            </span>
            <span class="font-medium text-white/95">
              We detected your browser prefers English. Would you like to view KD Labs in English?
            </span>
          </div>
        </div>

        <!-- Bottom: Action Buttons -->
        <div class="flex items-center justify-end gap-2 pl-10">
          <a
            id="switch-to-en-btn"
            href={enUrl}
            class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-orange-700 hover:bg-orange-50 transition-colors shadow-sm whitespace-nowrap"
          >
            Switch to English
          </a>
          <button
            id="dismiss-lang-banner-btn"
            type="button"
            class="px-2.5 py-1.5 rounded-lg text-xs font-bold text-white hover:bg-white/20 border border-white/30 hover:border-white/60 transition-colors whitespace-nowrap cursor-pointer"
          >
            Stay on Tiếng Việt
          </button>
        </div>

        <button
          id="close-lang-banner-x"
          type="button"
          class="text-white/80 hover:text-white transition-colors p-1 absolute top-2.5 right-2.5 cursor-pointer"
          aria-label="Close"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>
    </div>
  </aside>

  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('kd_lang_banner_dismissed') === '1') return;
        if (localStorage.getItem('kd_lang') === 'vi') return;

        var langs = [];
        if (Array.isArray(navigator.languages)) {
          for (var i = 0; i < navigator.languages.length; i++) {
            if (navigator.languages[i]) langs.push(String(navigator.languages[i]).toLowerCase());
          }
        }
        if (navigator.language) langs.push(String(navigator.language).toLowerCase());

        var hasVietnamese = langs.some(function (l) {
          return l === 'vi' || l.indexOf('vi-') === 0 || l.indexOf('vi_') === 0;
        });

        if (hasVietnamese) return;

        var banner = document.getElementById('lang-suggestion-banner');
        if (!banner) return;

        setTimeout(function () {
          banner.classList.remove('hidden');
          requestAnimationFrame(function () {
            banner.classList.remove('opacity-0', 'translate-y-3');
            banner.classList.add('opacity-100', 'translate-y-0');
          });
        }, 1000);

        function dismissBanner() {
          try {
            localStorage.setItem('kd_lang_banner_dismissed', '1');
          } catch (e) {}
          banner.classList.remove('opacity-100', 'translate-y-0');
          banner.classList.add('opacity-0', 'translate-y-3');
          setTimeout(function () {
            banner.classList.add('hidden');
          }, 300);
        }

        var switchBtn = document.getElementById('switch-to-en-btn');
        if (switchBtn) {
          switchBtn.addEventListener('click', function () {
            try {
              localStorage.setItem('kd_lang', 'en');
              localStorage.setItem('kd_lang_banner_dismissed', '1');
            } catch (e) {}
          });
        }

        var dismissBtn = document.getElementById('dismiss-lang-banner-btn');
        if (dismissBtn) {
          dismissBtn.addEventListener('click', dismissBanner);
        }

        var closeX = document.getElementById('close-lang-banner-x');
        if (closeX) {
          closeX.addEventListener('click', dismissBanner);
        }
      } catch (e) {}
    })();
  </script>
)}
