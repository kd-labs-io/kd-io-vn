---
import type { Locale } from '../data/i18n';
import { appsData } from '../data/apps';
import { siteConfig } from '../config/site';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const isVi = currentLang === 'vi';
const simpleOtp = appsData.find((a) => a.id === 'simple-otp');
const blogPath = isVi ? '/blog/' : '/en/blog/';
const kdCodeDetailUrl = isVi ? '/apps/kd-code/' : '/en/apps/kd-code/';
const simpleOtpDetailUrl = isVi ? '/apps/simple-otp/' : '/en/apps/simple-otp/';
---

<section id="hero-bento-section" class="relative overflow-hidden pt-6 pb-12 sm:pt-14 sm:pb-20 border-b border-stone-200/80 dark:border-stone-800/80">
  <!-- Subtle Zen Enso ambient aura in background -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] h-[520px] sm:w-[820px] sm:h-[820px] rounded-full zen-circle-gradient pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-14">

    <!-- Unified Hero Header -->
    <div class="max-w-3xl mx-auto text-center space-y-5 sm:space-y-6">
      <!-- Live Lab Badge -->
      <div class="inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 px-3.5 py-1.5 rounded-full border border-orange-200/90 dark:border-orange-950/80 bg-orange-50/90 dark:bg-orange-950/35 text-orange-800 dark:text-orange-300 text-[11px] sm:text-xs font-semibold tracking-wide shadow-2xs">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-600 dark:bg-orange-500"></span>
        </span>
        <span>KD Labs • AI-Native & Open-Source Lab</span>
        <span class="text-orange-400 dark:text-orange-700">•</span>
        <span class="text-stone-600 dark:text-stone-400 font-normal">
          {isVi ? 'Bùi Khương Duy (@kd-labs-io)' : 'Bui Khuong Duy (@kd-labs-io)'}
        </span>
      </div>

      <!-- Unified Zen Heading -->
      <h1 class="text-[1.85rem] leading-[1.18] sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight text-stone-900 dark:text-stone-100 sm:leading-[1.12] text-balance">
        {isVi ? 'Kiến trúc Phần mềm AI-Native.' : 'AI-Native Software Engineering.'}
        <span class="block text-orange-600 dark:text-orange-500 mt-1.5 text-balance">
          {isVi ? 'Bảo mật & Mã nguồn mở Tinh gọn.' : 'Open-Source & Hardware Security.'}
        </span>
      </h1>

      <!-- Unified Description -->
      <p class="text-[15px] sm:text-lg text-stone-600 dark:text-stone-300 max-w-2xl mx-auto leading-relaxed font-normal text-pretty">
        {isVi
          ? 'KD Labs phát triển các công cụ lập trình tích hợp AI Agent chuẩn giao thức ACP (KD Code), ứng dụng bảo mật két phần cứng 100% ngoại tuyến (Simple OTP) và các công trình nghiên cứu kỹ thuật chuyên sâu tại github.com/kd-labs-io.'
          : 'KD Labs engineers AI-Native developer tools over the Agent Client Protocol (KD Code), 100% offline hardware-backed security apps (Simple OTP), and deep-tech systems research at github.com/kd-labs-io.'}
      </p>

      <!-- Primary CTA Row -->
      <div data-nosnippet class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-3.5 pt-1 max-w-xs sm:max-w-none mx-auto">
        <a
          href="#showcase"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md hover:shadow-orange-500/25 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99]"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>{isVi ? 'Khám phá Sản phẩm' : 'Explore Products'}</span>
        </a>

        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-stone-900 hover:bg-black dark:bg-stone-100 dark:hover:bg-white text-white dark:text-stone-950 font-semibold text-sm shadow-sm transition-all duration-200 active:scale-[0.99]"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub @kd-labs-io</span>
        </a>

        <a
          href={blogPath}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl border border-stone-300 dark:border-stone-700 hover:border-orange-500 text-stone-800 dark:text-stone-200 hover:text-orange-600 dark:hover:text-orange-400 bg-white/80 dark:bg-stone-900/70 font-medium text-sm transition-all duration-200 backdrop-blur-sm active:scale-[0.99]"
        >
          <span>{isVi ? 'Đọc Blog Nghiên cứu' : 'Read Research Blog'}</span>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 4-Card Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6">

      <!-- BENTO CARD 1: KD Code (7 cols) -->
      <div class="lg:col-span-7 rounded-3xl border border-stone-200 dark:border-stone-800 bg-white/90 dark:bg-[#151412]/90 p-5 sm:p-7 shadow-sm hover:border-orange-500/50 transition-all duration-300 flex flex-col justify-between gap-6 group">
        <div class="space-y-4">
          <!-- Top Meta Row -->
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-3">
              <img
                src="/assets/kd-code/icon.png"
                alt="KD Code Icon"
                class="w-11 h-11 rounded-2xl object-cover border border-stone-200 dark:border-stone-800 shadow-sm shrink-0"
              />
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
                    KD Code
                  </h2>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-orange-500/10 text-orange-700 dark:text-orange-400 border border-orange-500/25">
                    VS Code ≥ 1.123
                  </span>
                </div>
                <p class="text-xs font-mono text-stone-500 dark:text-stone-400">
                  kd-labs-io/kd-code-extension • Agent Client Protocol (ACP)
                </p>
              </div>
            </div>

            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              MIT Open Source
            </span>
          </div>

          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            {isVi
              ? 'Điều phối Claude, Codex, OpenCode ngay trong VS Code qua giao thức chuẩn ACP. Chạy mỗi phiên chat trong một Git Worktree độc lập và đối sánh song song nhiều Agent (Best-of-N Compare).'
              : 'Orchestrate Claude, Codex, and OpenCode inside VS Code over the Agent Client Protocol (ACP). Isolate every chat in its own Git worktree and compare parallel runs (Best-of-N).'}
          </p>

          <!-- Interactive-style VS Code ACP Worktree Preview -->
          <div data-nosnippet class="rounded-2xl bg-stone-950 text-stone-100 p-3.5 sm:p-4 border border-stone-800 font-mono text-xs space-y-2.5 shadow-inner">
            <div class="flex items-center justify-between gap-2 pb-2 border-b border-stone-800/90 text-[11px]">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse shrink-0"></span>
                <span class="text-stone-200 font-semibold truncate">KD Code • Best-of-3 Worktree Compare</span>
              </div>
              <span class="shrink-0 text-[10px] text-orange-400 bg-orange-950/60 px-2 py-0.5 rounded border border-orange-800/50">
                ACP v1
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <div class="p-2.5 rounded-xl bg-stone-900/90 border border-emerald-500/40 space-y-1">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="font-bold text-emerald-400">Claude Code</span>
                  <span class="text-emerald-300 bg-emerald-950/70 px-1.5 py-0.2 rounded">Selected</span>
                </div>
                <div class="text-[10px] text-stone-400 truncate">wt/feat-auth-claude</div>
                <div class="text-[10px] text-stone-300">+64 −18 • 3 files</div>
              </div>

              <div class="p-2.5 rounded-xl bg-stone-900/90 border border-stone-800 space-y-1">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="font-bold text-stone-200">Codex Agent</span>
                  <span class="text-stone-400">Diff ready</span>
                </div>
                <div class="text-[10px] text-stone-400 truncate">wt/feat-auth-codex</div>
                <div class="text-[10px] text-stone-300">+52 −21 • 2 files</div>
              </div>

              <div class="p-2.5 rounded-xl bg-stone-900/90 border border-stone-800 space-y-1">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="font-bold text-stone-200">OpenCode</span>
                  <span class="text-orange-400">Diff ready</span>
                </div>
                <div class="text-[10px] text-stone-400 truncate">wt/feat-auth-opencode</div>
                <div class="text-[10px] text-stone-300">+71 −14 • 4 files</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Action Links -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-stone-100 dark:border-stone-800/80 text-xs font-semibold">
          <a
            href={kdCodeDetailUrl}
            class="inline-flex items-center gap-1.5 text-orange-600 dark:text-orange-500 hover:text-orange-700 dark:hover:text-orange-400"
          >
            <span>{isVi ? 'Xem kiến trúc & tính năng KD Code' : 'Explore KD Code architecture'}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="https://github.com/kd-labs-io/kd-code-extension"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 font-mono"
          >
            <span>github.com/kd-labs-io/kd-code-extension</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- BENTO CARD 2: Simple OTP (5 cols) -->
      <div class="lg:col-span-5 rounded-3xl border border-stone-200 dark:border-stone-800 bg-white/90 dark:bg-[#151412]/90 p-5 sm:p-7 shadow-sm hover:border-orange-500/50 transition-all duration-300 flex flex-col justify-between gap-6 group">
        <div class="space-y-4">
          <!-- Top Meta Row -->
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-3">
              <img
                src="/assets/simple-otp/icon.png"
                alt="Simple OTP Icon"
                class="w-11 h-11 rounded-2xl object-cover border border-stone-200 dark:border-stone-800 shadow-sm shrink-0"
              />
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
                    Simple OTP
                  </h2>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25">
                    100% Offline
                  </span>
                </div>
                <p class="text-xs font-mono text-stone-500 dark:text-stone-400">
                  iOS & Android • AES-256-GCM Enclave
                </p>
              </div>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            {isVi
              ? 'Ứng dụng xác thực 2FA hoàn toàn không quyền Internet. Mã hóa khóa bí mật trong iOS Keychain / Android Keystore, đã phát hành trên App Store.'
              : 'Zero-network 2FA authenticator with zero internet permissions. Secrets stay inside iOS Keychain / Android Keystore, live on the App Store.'}
          </p>

          <!-- Compact OTP Vault Mockup -->
          <div data-nosnippet class="rounded-2xl bg-stone-950 text-stone-100 p-3.5 border border-stone-800 space-y-2.5 shadow-inner">
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-stone-900/90 border border-stone-800">
              <div>
                <div class="text-[11px] font-semibold text-stone-200">GitHub • @kd-labs-io</div>
                <div class="text-lg font-mono font-bold tracking-wider text-orange-400 mt-0.5">582 910</div>
              </div>
              <div class="text-right">
                <span class="inline-block px-2 py-0.5 rounded bg-emerald-950/70 border border-emerald-800/50 text-[10px] font-mono text-emerald-400">
                  RFC 6238
                </span>
                <div class="text-[10px] font-mono text-stone-400 mt-1">Keychain Locked 🔒</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Action Links -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-stone-100 dark:border-stone-800/80 text-xs font-semibold">
          <a
            href={simpleOtp?.appStoreUrl || 'https://apps.apple.com/us/app/simple-otp/id6816673973'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-orange-600 dark:text-orange-500 hover:text-orange-700 dark:hover:text-orange-400"
          >
            <span>{isVi ? 'Tải trên App Store' : 'Download on App Store'}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a
            href={simpleOtpDetailUrl}
            class="inline-flex items-center gap-1.5 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100"
          >
            <span>{isVi ? 'Chi tiết & Mã nguồn' : 'Details & Source'}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- BENTO CARD 3: Open-Source Ecosystem @kd-labs-io (6 cols) -->
      <div class="lg:col-span-6 rounded-3xl border border-stone-200 dark:border-stone-800 bg-white/90 dark:bg-[#151412]/90 p-5 sm:p-7 shadow-sm hover:border-orange-500/50 transition-all duration-300 flex flex-col justify-between gap-5">
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-orange-600 dark:text-orange-500">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>Open-Source Organization</span>
            </span>
            <span class="text-xs font-mono text-stone-500 dark:text-stone-400">github.com/kd-labs-io</span>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100">
            {isVi ? 'Minh bạch Mã nguồn & Kiến trúc Zero-Trust' : 'Auditable Open-Source & Zero-Trust Craft'}
          </h3>

          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            {isVi
              ? 'Niềm tin kỹ thuật phải được chứng minh bằng mã nguồn. Các dự án tại kd-labs-io được phát hành theo giấy phép mở MIT, không gắn trình theo dõi (Zero Telemetry) và phân tách ranh giới bảo mật rõ ràng.'
              : 'Engineering trust must be verifiable. Repositories under kd-labs-io are released under the permissive MIT License with zero telemetry SDKs and strict security boundaries.'}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2 pt-1">
          <a
            href="https://github.com/kd-labs-io/kd-code-extension"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-900 hover:bg-orange-500/10 hover:border-orange-500/40 border border-stone-200 dark:border-stone-800 text-xs font-mono text-stone-800 dark:text-stone-200 transition-colors"
          >
            kd-labs-io/kd-code-extension
          </a>
          <a
            href="https://github.com/kd-labs-io/simple-otp"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-900 hover:bg-orange-500/10 hover:border-orange-500/40 border border-stone-200 dark:border-stone-800 text-xs font-mono text-stone-800 dark:text-stone-200 transition-colors"
          >
            kd-labs-io/simple-otp
          </a>
          <a
            href="https://github.com/kd-labs-io/kd-io-vn"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-xl bg-stone-100 dark:bg-stone-900 hover:bg-orange-500/10 hover:border-orange-500/40 border border-stone-200 dark:border-stone-800 text-xs font-mono text-stone-800 dark:text-stone-200 transition-colors"
          >
            kd-labs-io/kd-io-vn
          </a>
        </div>
      </div>

      <!-- BENTO CARD 4: Deep-Tech Research & System Architecture (6 cols) -->
      <div class="lg:col-span-6 rounded-3xl border border-stone-200 dark:border-stone-800 bg-white/90 dark:bg-[#151412]/90 p-5 sm:p-7 shadow-sm hover:border-orange-500/50 transition-all duration-300 flex flex-col justify-between gap-5">
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-orange-600 dark:text-orange-500">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>Applied Research & Systems</span>
            </span>
            <span class="text-xs font-mono text-stone-500 dark:text-stone-400">12 Bilingual Articles</span>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100">
            {isVi ? 'Nghiên cứu Chuyên sâu: AI Agents, Mật mã & Hệ thống' : 'Deep-Tech Research: AI Agents, Crypto & Systems'}
          </h3>

          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            {isVi
