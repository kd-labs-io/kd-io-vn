      },
      {
        id: 'mobile-security',
        tabLabel: 'Mobile & Security',
        badge: 'Flagship Mobile App',
        badgeSubtitle: 'iOS & Android • 100% Offline',
        titleLine1: 'Minimalist Design.',
        titleLine2: 'Hardware-Grade Security.',
        description:
          'KD Labs builds 100% offline mobile apps like Simple OTP 2FA. Your secret keys are encrypted with AES-256-GCM hardware security and stay exclusively on your device.',
        primaryCta: {
          label: 'Download on App Store',
          href: simpleOtp?.appStoreUrl || 'https://apps.apple.com/us/app/simple-otp/id6816673973',
          external: true,
          icon: 'apple',
        },
        secondaryCta: {
