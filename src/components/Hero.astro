---
import type { Locale } from '../data/i18n';
import { siteConfig } from '../config/site';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const isVi = currentLang === 'vi';
const blogPath = isVi ? '/blog/' : '/en/blog/';
const kdCodeDetailUrl = isVi ? '/apps/kd-code/' : '/en/apps/kd-code/';
const simpleOtpDetailUrl = isVi ? '/apps/simple-otp/' : '/en/apps/simple-otp/';
---

<section id="hero-bento-section" class="relative overflow-hidden pt-6 pb-12 sm:pt-12 sm:pb-20 border-b border-stone-200/80 dark:border-stone-800/80">
  <!-- Subtle Craft Ambient Aura in background -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] sm:w-[820px] sm:h-[820px] rounded-full zen-circle-gradient pointer-events-none -z-10"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">

    <!-- Minimal, Natural Text Header -->
    <div class="max-w-2xl mx-auto text-center space-y-4 sm:space-y-5">
      <!-- Simple, Clean 2-Line Sans-Serif Heading with Typewriter Effect -->
      <h1 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight text-stone-900 dark:text-stone-100 leading-[1.15]">
        <span class="block">
          AI-Native Labs
        </span>
        <span
          class="grid text-orange-600 dark:text-orange-500 mt-1.5"
          aria-label={isVi ? 'An toàn, hiệu quả, tốc độ' : 'Secure, efficient, fast'}
        >
          <span
            class="invisible select-none pointer-events-none [grid-area:1/1]"
            aria-hidden="true"
          >{isVi ? 'An toàn, hiệu quả, tốc độ' : 'Secure, efficient, fast'}</span>
          <span
            id="hero-typewriter-text"
            class="block w-full [grid-area:1/1]"
            data-text={isVi ? 'An toàn, hiệu quả, tốc độ' : 'Secure, efficient, fast'}
          >{isVi ? 'An toàn, hiệu quả, tốc độ' : 'Secure, efficient, fast'}</span>
        </span>
      </h1>

      <!-- Short, Effortless 1-Sentence Subtitle -->
      <p class="text-sm sm:text-lg text-stone-600 dark:text-stone-300 max-w-2xl mx-auto leading-relaxed font-normal text-pretty">
        {isVi
          ? 'Xây dựng các giải pháp toàn diện hỗ trợ chuyển đổi số, phát triển kỹ năng, sẵn sàng cho kỷ nguyên vươn mình.'
          : 'Building comprehensive solutions for digital transformation and skill development — ready for a new era of growth.'}
      </p>

      <!-- Clean Action Buttons -->
      <div data-nosnippet class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 pt-1 min-h-[44px]">
        <a
          href="#showcase"
          class="inline-flex items-center justify-center gap-1.5 sm:gap-2 w-[152px] sm:w-[176px] py-2.5 sm:py-3 rounded-full bg-orange-600 hover:bg-orange-700 text-white font-semibold text-xs sm:text-sm whitespace-nowrap shadow-md shadow-orange-600/20 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99]"
        >
          <span>{isVi ? 'Xem sản phẩm' : 'Explore Products'}</span>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 sm:gap-2 w-[176px] sm:w-[200px] py-2.5 sm:py-3 rounded-full craft-card hover:border-orange-500/50 text-stone-800 dark:text-stone-200 font-semibold text-xs sm:text-sm whitespace-nowrap transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.99]"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub @kd-labs-io</span>
        </a>
      </div>
    </div>

    <!-- Hero Landscape Artwork -->
    <div class="relative rounded-[1.75rem] sm:rounded-[2.25rem] craft-card craft-stack p-2 sm:p-3 overflow-hidden">
      <div class="relative rounded-[1.35rem] sm:rounded-[1.75rem] overflow-hidden aspect-[4/3] bg-stone-200 dark:bg-stone-900">
        <picture>
          <source
            type="image/webp"
            srcset="/assets/branding/hero-bg-home-800w.webp 640w, /assets/branding/hero-bg-home.webp 960w"
            sizes="(max-width: 640px) calc(100vw - 50px), (max-width: 1024px) 90vw, 960px"
          />
          <img
            src="/assets/branding/hero-bg-home.jpg"
            alt={isVi ? 'Không gian nghiên cứu và sáng tạo KD Labs nhìn ra cánh đồng lúa vàng Việt Nam' : 'KD Labs research and creative workspace overlooking golden Vietnamese rice fields'}
            width="960"
            height="720"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>

        <!-- Subtle Floating Craft Dock inside bottom of artwork (Desktop & Mobile) -->
        <div class="hidden sm:flex items-center justify-between gap-4 absolute bottom-4 left-4 right-4 px-4 py-2.5 rounded-2xl backdrop-blur-xl bg-white/85 dark:bg-[#161513]/85 border border-white/60 dark:border-stone-700/80 shadow-lg text-xs">
          <div class="flex items-center gap-3">
            <a href={kdCodeDetailUrl} class="inline-flex items-center gap-2 font-semibold text-stone-900 dark:text-stone-100 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              <img src="/assets/kd-code/icon.webp" alt="KD Code" width="20" height="20" loading="lazy" fetchpriority="low" decoding="async" class="w-5 h-5 rounded-md object-cover" />
              <span>KD Code (VS Code ACP)</span>
            </a>
            <span class="text-stone-300 dark:text-stone-700">•</span>
            <a href={simpleOtpDetailUrl} class="inline-flex items-center gap-2 font-semibold text-stone-900 dark:text-stone-100 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              <img src="/assets/simple-otp/icon.webp" alt="Simple OTP" width="20" height="20" loading="lazy" fetchpriority="low" decoding="async" class="w-5 h-5 rounded-md object-cover" />
              <span>Simple OTP (100% Offline)</span>
            </a>
          </div>

          <a
            href={blogPath}
            class="inline-flex items-center gap-1 font-medium text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
          >
            <span>{isVi ? 'Đọc blog nghiên cứu' : 'Read research blog'}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  function setupHeroTypewriter() {
    const el = document.getElementById('hero-typewriter-text');
    if (!el) return;

    const fullText = el.getAttribute('data-text') || '';
    if (!fullText) return;

    if (window.__kdTypewriterTimer) {
      clearTimeout(window.__kdTypewriterTimer);
    }

    let index = fullText.length;
    let isDeleting = true;
    el.textContent = fullText;

    function tick() {
      if (!isDeleting) {
        index++;
        el.textContent = fullText.slice(0, index);

        if (index === fullText.length) {
          // Pause at full phrase before re-typing
          isDeleting = true;
          window.__kdTypewriterTimer = setTimeout(tick, 3200);
          return;
        }
        // Natural typing speed (slightly slower after comma)
        const prevChar = fullText[index - 1];
        const delay = prevChar === ',' ? 260 : 65;
        window.__kdTypewriterTimer = setTimeout(tick, delay);
      } else {
        index--;
        el.textContent = fullText.slice(0, index);

        if (index === 0) {
          isDeleting = false;
          window.__kdTypewriterTimer = setTimeout(tick, 450);
          return;
        }
        window.__kdTypewriterTimer = setTimeout(tick, 32);
      }
    }

    window.__kdTypewriterTimer = setTimeout(tick, 5500);
  }

  setupHeroTypewriter();
  document.addEventListener('astro:after-swap', setupHeroTypewriter);
</script>
