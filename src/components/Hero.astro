---

<section id="hero-slider-section" class="relative overflow-hidden pt-8 pb-16 sm:pt-14 sm:pb-24">
  <!-- Subtle Zen Enso ambient aura in background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] sm:w-[780px] sm:h-[780px] rounded-full zen-circle-gradient pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Top Domain Slide Navigation Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8 sm:mb-12">
      <!-- Domain Pills / Tabs -->
      <div
        role="tablist"
        aria-label={currentLang === 'vi' ? 'Các lĩnh vực cốt lõi của KD Labs' : 'KD Labs Core Engineering Domains'}
        class="flex items-center gap-1.5 sm:gap-2 p-1.5 rounded-2xl border border-stone-200/90 dark:border-stone-800/90 bg-white/80 dark:bg-stone-900/70 backdrop-blur-md overflow-x-auto max-w-full no-scrollbar shadow-sm"
      >
        {slides.map((slide, index) => (
          <button
            type="button"
            role="tab"
            id={`hero-tab-${slide.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`hero-slide-${slide.id}`}
            data-slide-target={index}
            class={`hero-tab-btn relative flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all duration-200 cursor-pointer overflow-hidden ${
              index === 0
                ? 'bg-orange-600 text-white shadow-sm'
                : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 hover:bg-stone-100/80 dark:hover:bg-stone-800/60'
            }`}
          >
            <span class="font-mono text-[10px] opacity-75">0{index + 1}</span>
            <span>{slide.tabLabel}</span>
            <!-- Progress bar indicator inside active tab -->
            <span
              data-tab-progress={index}
              class="absolute bottom-0 left-0 h-0.5 bg-white/80 transition-none"
              style="width: 0%;"
            ></span>
          </button>
        ))}
      </div>

      <!-- Prev / Next Controls -->
      <div class="hidden sm:flex items-center gap-2">
        <button
          type="button"
          id="hero-prev-btn"
          aria-label={currentLang === 'vi' ? 'Slide trước' : 'Previous slide'}
          class="w-9 h-9 rounded-xl border border-stone-200 dark:border-stone-800 bg-white/80 dark:bg-stone-900/70 text-stone-600 dark:text-stone-300 hover:border-orange-500 hover:text-orange-600 dark:hover:text-orange-400 flex items-center justify-center transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="hero-next-btn"
          aria-label={currentLang === 'vi' ? 'Slide tiếp theo' : 'Next slide'}
          class="w-9 h-9 rounded-xl border border-stone-200 dark:border-stone-800 bg-white/80 dark:bg-stone-900/70 text-stone-600 dark:text-stone-300 hover:border-orange-500 hover:text-orange-600 dark:hover:text-orange-400 flex items-center justify-center transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Slides Wrapper -->
    <div class="relative">
      {slides.map((slide, index) => {
        const HeadingTag = index === 0 ? 'h1' : 'h2';
        return (
          <div
            id={`hero-slide-${slide.id}`}
            role="tabpanel"
            aria-labelledby={`hero-tab-${slide.id}`}
            data-slide-panel={index}
            class={`hero-slide-panel transition-opacity duration-300 ${
              index === 0 ? 'block opacity-100' : 'hidden opacity-0'
            }`}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
              
              <!-- Left Content Column (7 cols) -->
              <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                
                <!-- Live Domain Tag -->
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-orange-200 dark:border-orange-950/80 bg-orange-50/80 dark:bg-orange-950/30 text-orange-800 dark:text-orange-300 text-xs font-semibold tracking-wide">
                  <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-600 dark:bg-orange-500"></span>
                  </span>
                  <span>{slide.badge}</span>
                  <span class="text-orange-400 dark:text-orange-700">•</span>
                  <span class="text-stone-500 dark:text-stone-400 font-normal">{slide.badgeSubtitle}</span>
                </div>

                <!-- Big Zen Heading -->
                <HeadingTag class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-[1.12]">
                  {slide.titleLine1}
                  <span class="block text-orange-600 dark:text-orange-500 mt-1">
                    {slide.titleLine2}
                  </span>
                </HeadingTag>

                <!-- Domain Description -->
                <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
                  {slide.description}
                </p>

                <!-- CTA Buttons -->
                <div data-nosnippet class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
                  <a
                    href={slide.primaryCta.href}
                    target={slide.primaryCta.external ? '_blank' : undefined}
                    rel={slide.primaryCta.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md hover:shadow-orange-500/25 transition-all duration-200 transform hover:-translate-y-0.5"
                  >
                    {slide.primaryCta.icon === 'apple' && (
                      <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24">
                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.06 1.71-.93 2.73.99.08 2.02-.48 2.63-1.23z"/>
                      </svg>
                    )}
                    {slide.primaryCta.icon === 'spark' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                    )}
                    {slide.primaryCta.icon === 'globe' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                      </svg>
                    )}
                    {slide.primaryCta.icon === 'layers' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                      </svg>
                    )}
                    {slide.primaryCta.icon === 'terminal' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    )}
                    {slide.primaryCta.icon === 'book' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                      </svg>
                    )}
                    <span>{slide.primaryCta.label}</span>
                  </a>

                  <a
                    href={slide.secondaryCta.href}
