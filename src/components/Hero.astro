    const section = document.getElementById('hero-slider-section');
    if (!section) return;

    const tabs = Array.from(section.querySelectorAll('[data-slide-target]'));
    const panels = Array.from(section.querySelectorAll('[data-slide-panel]'));
    const dots = Array.from(section.querySelectorAll('[data-slide-dot]'));
    const progressBars = Array.from(section.querySelectorAll('[data-tab-progress]'));
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');

    const total = panels.length;
    if (total === 0) return;

    let current = 0;
    let isPaused = false;
    const DURATION = 6500;
    let elapsed = 0;
    let lastTick = performance.now();

    function activateSlide(index) {
      current = (index + total) % total;
      elapsed = 0;

      panels.forEach((panel, i) => {
        if (i === current) {
          panel.classList.remove('hidden', 'opacity-0');
          panel.classList.add('block', 'opacity-100');
        } else {
          panel.classList.add('hidden', 'opacity-0');
          panel.classList.remove('block', 'opacity-100');
        }
      });

      tabs.forEach((tab, i) => {
        const active = i === current;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active) {
          tab.classList.add('bg-orange-600', 'text-white', 'shadow-sm');
          tab.classList.remove(
            'text-stone-600',
            'dark:text-stone-400',
            'hover:text-stone-900',
            'dark:hover:text-stone-200',
            'hover:bg-stone-100/80',
            'dark:hover:bg-stone-800/60'
          );
        } else {
          tab.classList.remove('bg-orange-600', 'text-white', 'shadow-sm');
          tab.classList.add(
            'text-stone-600',
            'dark:text-stone-400',
            'hover:text-stone-900',
            'dark:hover:text-stone-200',
            'hover:bg-stone-100/80',
            'dark:hover:bg-stone-800/60'
          );
        }
      });

      dots.forEach((dot, i) => {
        if (i === current) {
          dot.classList.add('w-8', 'bg-orange-600', 'dark:bg-orange-500');
          dot.classList.remove('w-2', 'bg-stone-300', 'dark:bg-stone-700');
        } else {
          dot.classList.remove('w-8', 'bg-orange-600', 'dark:bg-orange-500');
          dot.classList.add('w-2', 'bg-stone-300', 'dark:bg-stone-700');
        }
      });

      progressBars.forEach((bar) => {
        bar.style.width = '0%';
      });
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        activateSlide(idx);
      });
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        activateSlide(idx);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => activateSlide(current - 1));
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => activateSlide(current + 1));
    }

    section.addEventListener('mouseenter', () => {
      isPaused = true;
    });
    section.addEventListener('mouseleave', () => {
      isPaused = false;
      lastTick = performance.now();
    });

    function loop(now) {
      const dt = now - lastTick;
      lastTick = now;

      if (!isPaused) {
        elapsed += dt;
        const pct = Math.min(100, (elapsed / DURATION) * 100);
        if (progressBars[current]) {
          progressBars[current].style.width = pct + '%';
        }
        if (elapsed >= DURATION) {
          activateSlide(current + 1);
        }
      }
      requestAnimationFrame(loop);
    }

    requestAnimationFrame(loop);
  })();
</script>
