          label: 'Khám phá Hệ sinh thái',
          href: '#showcase',
          external: false,
          icon: 'spark',
        },
        secondaryCta: {
          label: 'Đọc Blog Nghiên cứu',
          href: blogPath,
          external: false,
        },
        stats: [
          { value: 'AI-Native', label: 'Multi-Agent & LLM' },
          { value: 'Full-Stack', label: 'Web & Mobile Apps' },
