<script is:inline>
  function setupHeroCraftInteractions() {
    // 1. KD Code Segmented Tab Switcher
    const tabBtns = document.querySelectorAll('.kd-hero-tab');
    const panelCompare = document.getElementById('kd-panel-compare');
    const panelRegistry = document.getElementById('kd-panel-registry');

    if (tabBtns.length && panelCompare && panelRegistry) {
      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-kd-tab');
          tabBtns.forEach((b) => {
            const active = b.getAttribute('data-kd-tab') === target;
            b.classList.toggle('bg-orange-600', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('font-semibold', active);
            b.classList.toggle('text-stone-400', !active);
          });
          panelCompare.classList.toggle('hidden', target !== 'compare');
          panelRegistry.classList.toggle('hidden', target !== 'registry');
        });
      });
    }

    // 2. Simple OTP Demo Copy Interaction
    const otpBtn = document.getElementById('hero-otp-copy-card');
    const otpBadge = document.getElementById('hero-otp-copied-badge');
    if (otpBtn && otpBadge) {
      otpBtn.addEventListener('click', async () => {
        const code = otpBtn.getAttribute('data-otp-code') || '582910';
        try {
          await navigator.clipboard.writeText(code);
          otpBadge.classList.remove('hidden');
          setTimeout(() => {
            otpBadge.classList.add('hidden');
          }, 1800);
        } catch (e) {}
      });
    }
  }

  setupHeroCraftInteractions();
  document.addEventListener('astro:after-swap', setupHeroCraftInteractions);
</script>
