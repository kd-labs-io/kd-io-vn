        primaryCta: {
          label: 'Explore Ecosystem',
          href: '#showcase',
          external: false,
          icon: 'spark',
        },
        secondaryCta: {
          label: 'Read Research Blog',
          href: blogPath,
          external: false,
        },
        stats: [
          { value: 'AI-Native', label: 'Multi-Agent & LLM' },
          { value: 'Full-Stack', label: 'Web & Mobile Apps' },
          { value: 'Cloud K8s', label: 'DevOps & GitOps' },
          { value: 'Zero-Trust', label: 'Security & Crypto' },
