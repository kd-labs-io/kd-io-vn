---
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';
import { siteConfig } from '../config/site';
import { appsData } from '../data/apps';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = getTranslations(currentLang);
const simpleOtp = appsData.find((a) => a.id === 'simple-otp');
---

<section class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28">
  <!-- Subtle Zen Enso ambient aura in background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] sm:w-[750px] sm:h-[750px] rounded-full zen-circle-gradient pointer-events-none -z-10"></div>
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column (7 cols) -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Live Developer Tag -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-orange-200 dark:border-orange-950/80 bg-orange-50/80 dark:bg-orange-950/30 text-orange-800 dark:text-orange-300 text-xs font-semibold tracking-wide">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-600 dark:bg-orange-500"></span>
          </span>
          <span>{t.hero.badge}</span>
          <span class="text-orange-400 dark:text-orange-700">•</span>
          <span class="text-stone-500 dark:text-stone-400 font-normal">{t.hero.badgeSubtitle}</span>
        </div>

        <!-- Big Zen Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-[1.12]">
          {t.hero.titleLine1}
          <span class="block text-orange-600 dark:text-orange-500 mt-1">
            {t.hero.titleLine2}
          </span>
        </h1>

        <!-- Studio Description -->
        <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
          {t.hero.description}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
          <!-- Apple App Store CTA -->
          <a
            href={simpleOtp?.appStoreUrl || 'https://apps.apple.com/us/app/simple-otp/id6816673973'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm shadow-md hover:shadow-orange-500/25 transition-all duration-200 transform hover:-translate-y-0.5"
          >
            <!-- Apple Icon -->
            <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.06 1.71-.93 2.73.99.08 2.02-.48 2.63-1.23z"/>
            </svg>
            <span>{t.hero.ctaAppStore}</span>
          </a>

          <!-- Browse Apps Anchor -->
          <a
            href="#showcase"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl border border-stone-300 dark:border-stone-700 hover:border-orange-500 text-stone-800 dark:text-stone-200 hover:text-orange-600 dark:hover:text-orange-400 bg-white/70 dark:bg-stone-900/60 font-medium text-sm transition-all duration-200 backdrop-blur-sm"
          >
            <span>{t.hero.ctaBrowseApps}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="pt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left border-t border-stone-200/80 dark:border-stone-800/80 max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="text-xl font-bold text-stone-900 dark:text-stone-100">100%</div>
            <div class="text-xs text-stone-600 dark:text-stone-300">{t.hero.statsOffline}</div>
          </div>
          <div>
            <div class="text-xl font-bold text-orange-600 dark:text-orange-500">AES-256</div>
            <div class="text-xs text-stone-600 dark:text-stone-300">{t.hero.statsSecurity}</div>
          </div>
          <div>
            <div class="text-xl font-bold text-stone-900 dark:text-stone-100">0% Ads</div>
            <div class="text-xs text-stone-600 dark:text-stone-300">{t.hero.statsAdFree}</div>
          </div>
          <div>
            <div class="text-xl font-bold text-stone-900 dark:text-stone-100">MIT</div>
            <div class="text-xs text-stone-600 dark:text-stone-300">{t.hero.statsOpenSource}</div>
          </div>
        </div>

      </div>

      <!-- Right Mockup Column (5 cols) -->
      <div class="lg:col-span-5 flex justify-center">
        <!-- Interactive Zen Phone Mockup Previewing 'Simple OTP' -->
        <div class="relative w-full max-w-[340px] rounded-[40px] p-3.5 bg-gradient-to-b from-stone-200 via-stone-300 to-stone-400 dark:from-stone-800 dark:via-stone-900 dark:to-stone-950 shadow-2xl border border-stone-300 dark:border-stone-700">
          
          <!-- Speaker notch -->
          <div class="absolute top-6 left-1/2 -translate-x-1/2 w-18 h-4 bg-stone-900 rounded-full z-20 flex items-center justify-center">
            <div class="w-2.5 h-2.5 rounded-full bg-stone-800 border border-stone-700"></div>
          </div>

          <!-- Phone Inner Screen -->
          <div class="relative w-full rounded-[32px] overflow-hidden bg-stone-950 text-stone-100 p-5 pt-9 flex flex-col justify-between aspect-[9/18.5] shadow-inner border border-stone-800">
            
            <!-- App Top Header -->
            <div class="flex items-center justify-between text-xs pb-3 border-b border-stone-800/80">
              <div class="flex items-center gap-2">
                <img src="/assets/simple-otp/icon.png" alt="Simple OTP Icon" class="w-5 h-5 rounded-md object-cover shadow-sm" />
                <span class="tracking-wide font-bold text-orange-400">Simple OTP</span>
              </div>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-stone-900 text-[10px] text-emerald-400 border border-emerald-900/40">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                100% Offline
              </span>
            </div>

            <!-- TOTP Cards List -->
            <div class="space-y-3 my-auto py-2">
              
              <!-- Card 1: Google Account -->
              <div class="rounded-2xl bg-stone-900/90 border border-stone-800 p-3 space-y-2 shadow-sm">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center font-bold text-[10px]">
                      G
                    </div>
                    <div>
                      <div class="text-xs font-semibold text-white leading-tight">Google</div>
                      <div class="text-[10px] text-stone-400">duybk@gmail.com</div>
                    </div>
                  </div>
                  
                  <!-- 30s Countdown ring -->
                  <div class="relative w-6 h-6 flex items-center justify-center">
                    <svg class="w-full h-full -rotate-90" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" stroke="#333" stroke-width="2.5" fill="none" />
                      <circle cx="12" cy="12" r="10" stroke="#F76B00" stroke-width="2.5" stroke-dasharray="62.8" stroke-dashoffset="15" stroke-linecap="round" fill="none" />
                    </svg>
                    <span class="absolute text-[8px] font-mono text-stone-300">22</span>
                  </div>
                </div>

                <!-- OTP digits -->
                <div class="flex items-center justify-between pt-1">
                  <span class="text-xl font-mono font-bold tracking-wider text-orange-400">
                    582 910
                  </span>
                  <span class="px-2 py-0.5 rounded-md bg-stone-800 text-[10px] text-stone-300 font-medium">
                    1-tap copy
                  </span>
                </div>
              </div>

              <!-- Card 2: GitHub Account -->
              <div class="rounded-2xl bg-stone-900/90 border border-stone-800 p-3 space-y-2 shadow-sm">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-lg bg-stone-800 text-stone-200 flex items-center justify-center font-bold text-[10px]">
                      GH
                    </div>
                    <div>
                      <div class="text-xs font-semibold text-white leading-tight">GitHub</div>
                      <div class="text-[10px] text-stone-400">001123</div>
                    </div>
                  </div>
                  
                  <!-- Countdown ring -->
                  <div class="relative w-6 h-6 flex items-center justify-center">
                    <svg class="w-full h-full -rotate-90" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" stroke="#333" stroke-width="2.5" fill="none" />
                      <circle cx="12" cy="12" r="10" stroke="#F76B00" stroke-width="62.8" stroke-dasharray="62.8" stroke-dashoffset="35" stroke-linecap="round" fill="none" />
                    </svg>
                    <span class="absolute text-[8px] font-mono text-stone-300">14</span>
                  </div>
                </div>

                <!-- OTP digits -->
                <div class="flex items-center justify-between pt-1">
                  <span class="text-xl font-mono font-bold tracking-wider text-white">
                    734 182
                  </span>
                  <span class="px-2 py-0.5 rounded-md bg-stone-800 text-[10px] text-stone-300 font-medium">
                    1-tap copy
                  </span>
                </div>
              </div>

            </div>

            <!-- Bottom Mascot Companion Speech Bar -->
            <div class="pt-2 border-t border-stone-800/80 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <!-- Lock-bot Mascot Avatar -->
                <div class="w-7 h-7 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-stone-950 font-bold text-xs shadow-sm">
                  🔒
                </div>
                <div class="text-[10px] text-stone-300">
                  <span class="text-orange-400 font-semibold">Bé Khóa:</span> Sẵn sàng bảo vệ!
                </div>
              </div>

              <div class="w-6 h-6 rounded-full bg-orange-600 text-white flex items-center justify-center font-bold text-xs shadow-sm">
                +
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
