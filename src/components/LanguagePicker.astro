---
import type { Locale } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;

const viUrl = getLocalizedPath(currentPath, 'vi');
const enUrl = getLocalizedPath(currentPath, 'en');
---

<div class="inline-flex items-center p-0.5 rounded-full border border-stone-200 dark:border-stone-800 bg-stone-100/70 dark:bg-stone-900/80 text-xs font-medium">
  <a
    href={viUrl}
    class={`px-2.5 py-1 rounded-full transition-all duration-200 ${
      currentLang === 'vi'
        ? 'bg-orange-600 text-white shadow-sm font-semibold'
        : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100'
    }`}
    aria-label="VI — Tiếng Việt"
    title="Tiếng Việt"
    onclick="localStorage.setItem('kd_lang', 'vi')"
  >
    VI
  </a>
  <a
    href={enUrl}
    class={`px-2.5 py-1 rounded-full transition-all duration-200 ${
      currentLang === 'en'
        ? 'bg-orange-600 text-white shadow-sm font-semibold'
        : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100'
    }`}
    aria-label="EN — English"
    title="English"
    onclick="localStorage.setItem('kd_lang', 'en')"
  >
    EN
  </a>
</div>
