---
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';
import { siteConfig } from '../config/site';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSuggestionBanner from './LanguageSuggestionBanner.astro';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = getTranslations(currentLang);
const homeUrl = currentLang === 'vi' ? '/' : `/${currentLang}/`;
const isHomePage = currentLang === 'vi'
  ? (Astro.url.pathname === '/' || Astro.url.pathname === '')
  : (Astro.url.pathname === `/${currentLang}/` || Astro.url.pathname === `/${currentLang}`);
const pressUrl = currentLang === 'vi' ? '/press/' : `/${currentLang}/press/`;
const privacyUrl = currentLang === 'vi' ? '/privacy/' : `/${currentLang}/privacy/`;
const blogUrl = currentLang === 'vi' ? '/blog/' : `/${currentLang}/blog/`;
---

<header class="sticky top-0 z-50 transition-colors duration-200">
  <!-- Language Suggestion Top Banner -->
  <LanguageSuggestionBanner currentLang={currentLang} />

  <div class="backdrop-blur-md bg-stone-50/85 dark:bg-[#0F0E0D]/85 border-b border-stone-200/80 dark:border-stone-800/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo KD Labs -->
      <a href={homeUrl} class="group flex items-center space-x-3 text-inherit no-underline">
        <!-- Zen Enso Ring Logo -->
        <div class="relative w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl bg-orange-500/10 dark:bg-orange-500/15 border border-orange-500/30 group-hover:border-orange-500 transition-colors duration-300">
          <svg class="w-6 h-6 text-orange-600 dark:text-orange-500 transition-transform duration-300 group-hover:scale-105" viewBox="0 0 24 24" fill="none">
            <!-- Zen Enso open circle & 2 circles (Key & Data) -->
            <path
              d="M 13.5 3.1 A 8.9 8.9 0 1 0 20.5 15.6"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
            />
            <circle cx="15.6" cy="6.8" r="2" class="fill-orange-400 dark:fill-orange-400" />
            <circle cx="18.8" cy="11.5" r="2" class="fill-orange-400 dark:fill-orange-400" />
          </svg>
        </div>
        
        <div class="flex flex-col">
          <span class="text-lg sm:text-xl font-bold tracking-tight text-stone-900 dark:text-stone-100 flex items-center gap-1.5">
            KD Labs
          </span>
          <span class="text-[10px] uppercase tracking-widest text-stone-600 dark:text-stone-300 font-medium">
            Keep Development
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
        <a
          href={isHomePage ? '#showcase' : `${homeUrl}#showcase`}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.apps}
        </a>
        <a
          href={isHomePage ? '#philosophy' : `${homeUrl}#philosophy`}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.philosophy}
        </a>
        <a
          href={blogUrl}
          class={`transition-colors duration-150 ${
            Astro.url.pathname.includes('/blog')
              ? 'text-orange-600 dark:text-orange-400 font-semibold'
              : 'text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400'
          }`}
        >
          {t.nav.blog}
        </a>
        <a
          href={pressUrl}
          class={`transition-colors duration-150 ${
            Astro.url.pathname.includes('/press')
              ? 'text-orange-600 dark:text-orange-400 font-semibold'
              : 'text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400'
          }`}
        >
          {t.nav.press}
        </a>
        <a
          href={privacyUrl}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.privacy}
        </a>
        <a
          href={isHomePage ? '#contact' : `${homeUrl}#contact`}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.support}
        </a>
      </nav>

      <!-- Desktop Right Controls -->
      <div class="hidden md:flex items-center space-x-3">
        <!-- Language Switcher -->
        <LanguagePicker currentLang={currentLang} />

        <!-- Theme Toggle -->
        <ThemeToggle />

        <!-- Google Play Link Button -->
        <a
          href={siteConfig.googlePlayDevUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-stone-900 text-stone-50 hover:bg-orange-600 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-orange-500 dark:hover:text-white transition-all duration-200 shadow-sm"
        >
          <!-- Google Play Icon -->
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.793 12 3.61 22.186c-.37-.367-.61-.88-.61-1.464V3.278c0-.584.24-1.097.61-1.464zm1.402-.822L16.273 7.42 14.5 9.193 5.011.992zm9.49 9.873l1.774 1.774-11.264 6.43 9.49-8.204zm2.463-.997l2.827 1.616c.82.469.82 1.233 0 1.701l-2.827 1.616-1.993-1.993 1.993-1.94z"/>
          </svg>
          <span>Google Play</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center space-x-2 md:hidden">
        <LanguagePicker currentLang={currentLang} />
        <ThemeToggle />
        
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-stone-600 dark:text-stone-300 hover:text-stone-900 dark:hover:text-white hover:bg-stone-200/50 dark:hover:bg-stone-800/50"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-[#121110] px-4 pt-3 pb-6 space-y-3">
    <a
      href={isHomePage ? '#showcase' : `${homeUrl}#showcase`}
      class="block py-2 text-base font-medium text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400"
    >
      {t.nav.apps}
    </a>
    <a
      href={isHomePage ? '#philosophy' : `${homeUrl}#philosophy`}
      class="block py-2 text-base font-medium text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400"
    >
      {t.nav.philosophy}
    </a>
    <a
      href={blogUrl}
      class={`block py-2 text-base font-medium ${
        Astro.url.pathname.includes('/blog')
          ? 'text-orange-600 dark:text-orange-400 font-semibold'
          : 'text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400'
      }`}
    >
      {t.nav.blog}
    </a>
    <a
      href={pressUrl}
      class={`block py-2 text-base font-medium ${
        Astro.url.pathname.includes('/press')
          ? 'text-orange-600 dark:text-orange-400 font-semibold'
          : 'text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400'
      }`}
    >
      {t.nav.press}
    </a>
    <a
      href={privacyUrl}
      class="block py-2 text-base font-medium text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400"
    >
      {t.nav.privacy}
    </a>
    <a
      href={isHomePage ? '#contact' : `${homeUrl}#contact`}
      class="block py-2 text-base font-medium text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400"
    >
      {t.nav.support}
    </a>
    <div class="pt-2">
      <a
        href={siteConfig.googlePlayDevUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-semibold bg-orange-600 text-white shadow-sm hover:bg-orange-700"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.609 1.814L13.793 12 3.61 22.186c-.37-.367-.61-.88-.61-1.464V3.278c0-.584.24-1.097.61-1.464zm1.402-.822L16.273 7.42 14.5 9.193 5.011.992zm9.49 9.873l1.774 1.774-11.264 6.43 9.49-8.204zm2.463-.997l2.827 1.616c.82.469.82 1.233 0 1.701l-2.827 1.616-1.993-1.993 1.993-1.94z"/>
        </svg>
        <span>KD Labs trên Google Play</span>
      </a>
    </div>
  </div>
  </div>
</header>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
