---
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';
import { siteConfig } from '../config/site';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSuggestionBanner from './LanguageSuggestionBanner.astro';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = getTranslations(currentLang);
const homeUrl = currentLang === 'vi' ? '/' : `/${currentLang}/`;
const isHomePage = currentLang === 'vi'
  ? (Astro.url.pathname === '/' || Astro.url.pathname === '')
  : (Astro.url.pathname === `/${currentLang}/` || Astro.url.pathname === `/${currentLang}`);
const pressUrl = currentLang === 'vi' ? '/press/' : `/${currentLang}/press/`;
const privacyUrl = currentLang === 'vi' ? '/privacy/' : `/${currentLang}/privacy/`;
const blogUrl = currentLang === 'vi' ? '/blog/' : `/${currentLang}/blog/`;

const isAppsActive = Astro.url.pathname.includes('/apps/');
const isBlogActive = Astro.url.pathname.includes('/blog');
const isPressActive = Astro.url.pathname.includes('/press');
const isPrivacyActive = Astro.url.pathname.includes('/privacy');
---

<header class="sticky top-0 z-50 transition-all duration-200">
  <!-- Language Suggestion Top Banner -->
  <LanguageSuggestionBanner currentLang={currentLang} />

  <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 pt-2.5 sm:pt-4 pb-1.5">
    <!-- Craft.do Floating Glass Pill Navbar -->
    <div class="craft-pill-nav rounded-full backdrop-blur-2xl bg-white/85 dark:bg-[#161513]/85 border border-stone-200/90 dark:border-stone-800/90 px-3 sm:px-4 py-2 transition-all duration-200">
      <div class="flex items-center justify-between gap-2">
        
        <!-- Left: Logo KD Labs -->
        <a href={homeUrl} class="group flex items-center gap-2.5 text-inherit no-underline shrink-0 pl-0.5">
          <!-- Zen Enso Craft App-Icon Badge -->
          <div class="relative w-9 h-9 flex items-center justify-center rounded-full bg-gradient-to-b from-orange-500/15 to-orange-600/5 dark:from-orange-500/20 dark:to-orange-500/10 border border-orange-500/30 group-hover:border-orange-500 shadow-2xs transition-all duration-300 shrink-0">
            <svg class="w-5 h-5 text-orange-600 dark:text-orange-500 transition-transform duration-300 group-hover:scale-105" viewBox="0 0 24 24" fill="none">
              <path
                d="M 13.5 3.1 A 8.9 8.9 0 1 0 20.5 15.6"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
              />
              <circle cx="15.6" cy="6.8" r="2" class="fill-orange-400 dark:fill-orange-400" />
              <circle cx="18.8" cy="11.5" r="2" class="fill-orange-400 dark:fill-orange-400" />
            </svg>
          </div>
          
          <div class="flex flex-col">
            <span class="text-sm sm:text-base font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-none flex items-center gap-1.5">
              KD Labs
            </span>
            <span class="text-[9px] uppercase tracking-widest text-stone-500 dark:text-stone-400 font-mono mt-0.5">
              Keep Development
            </span>
          </div>
        </a>

        <!-- Center: Craft Segmented Pill Navigation Links (Desktop) -->
        <nav
          aria-label="Main Navigation"
          class="hidden lg:flex items-center p-1 rounded-full bg-stone-100/80 dark:bg-stone-900/75 border border-stone-200/70 dark:border-stone-800/80 text-xs font-medium"
        >
          <a
            href={isHomePage ? '#showcase' : `${homeUrl}#showcase`}
            class={`px-3.5 py-1.5 rounded-full transition-all duration-150 ${
              isAppsActive
                ? 'bg-white dark:bg-stone-800 text-orange-600 dark:text-orange-400 font-semibold shadow-2xs'
                : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white hover:bg-white/80 dark:hover:bg-stone-800/70'
            }`}
          >
            {t.nav.apps}
          </a>
          <a
            href={isHomePage ? '#philosophy' : `${homeUrl}#philosophy`}
            class="px-3.5 py-1.5 rounded-full text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white hover:bg-white/80 dark:hover:bg-stone-800/70 transition-all duration-150"
          >
            {t.nav.philosophy}
          </a>
          <a
            href={blogUrl}
            class={`px-3.5 py-1.5 rounded-full transition-all duration-150 ${
              isBlogActive
                ? 'bg-white dark:bg-stone-800 text-orange-600 dark:text-orange-400 font-semibold shadow-2xs'
                : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white hover:bg-white/80 dark:hover:bg-stone-800/70'
            }`}
          >
            {t.nav.blog}
          </a>
          <a
            href={pressUrl}
            class={`px-3.5 py-1.5 rounded-full transition-all duration-150 ${
              isPressActive
                ? 'bg-white dark:bg-stone-800 text-orange-600 dark:text-orange-400 font-semibold shadow-2xs'
                : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white hover:bg-white/80 dark:hover:bg-stone-800/70'
            }`}
          >
            {t.nav.press}
          </a>
          <a
            href={privacyUrl}
            class={`px-3.5 py-1.5 rounded-full transition-all duration-150 ${
              isPrivacyActive
                ? 'bg-white dark:bg-stone-800 text-orange-600 dark:text-orange-400 font-semibold shadow-2xs'
                : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white hover:bg-white/80 dark:hover:bg-stone-800/70'
            }`}
          >
            {t.nav.privacy}
          </a>
          <a
            href={isHomePage ? '#contact' : `${homeUrl}#contact`}
            class="px-3.5 py-1.5 rounded-full text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white hover:bg-white/80 dark:hover:bg-stone-800/70 transition-all duration-150"
          >
            {t.nav.support}
          </a>
        </nav>

        <!-- Right: Unified Controls (Desktop & Mobile) -->
        <div class="flex items-center gap-1.5 lg:gap-2">
          <LanguagePicker currentLang={currentLang} />
          <ThemeToggle />

          <a
            href={siteConfig.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden lg:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-stone-900 text-stone-50 hover:bg-orange-600 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-orange-500 dark:hover:text-white transition-all duration-200 shadow-2xs active:scale-95"
          >
            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>@kd-labs-io</span>
          </a>

          <button
            id="mobile-menu-btn"
            type="button"
            class="inline-flex lg:hidden items-center justify-center p-2 rounded-full border border-stone-200 dark:border-stone-800 bg-stone-100/80 dark:bg-stone-900/80 text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-300 dark:hover:border-orange-800/60 transition-all duration-200 shadow-2xs cursor-pointer active:scale-95"
            aria-label="Toggle Navigation Menu"
            aria-expanded="false"
          >
            <svg id="mobile-menu-icon-open" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="mobile-menu-icon-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- Floating Craft Mobile Popover Menu -->
    <div
      id="mobile-menu"
      class="hidden lg:hidden mt-2 rounded-3xl craft-card backdrop-blur-2xl bg-white/95 dark:bg-[#161513]/95 p-3 space-y-1 shadow-2xl"
    >
      <a
        href={isHomePage ? '#showcase' : `${homeUrl}#showcase`}
        class={`flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-sm font-medium transition-colors ${
          isAppsActive
            ? 'bg-orange-500/10 text-orange-600 dark:text-orange-400 font-semibold'
            : 'text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400'
        }`}
      >
        <span>{t.nav.apps}</span>
        <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href={isHomePage ? '#philosophy' : `${homeUrl}#philosophy`}
        class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
      >
        <span>{t.nav.philosophy}</span>
        <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href={blogUrl}
        class={`flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-sm font-medium transition-colors ${
          isBlogActive
            ? 'bg-orange-500/10 text-orange-600 dark:text-orange-400 font-semibold'
            : 'text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400'
        }`}
      >
        <span>{t.nav.blog}</span>
        <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href={pressUrl}
        class={`flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-sm font-medium transition-colors ${
          isPressActive
            ? 'bg-orange-500/10 text-orange-600 dark:text-orange-400 font-semibold'
            : 'text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400'
        }`}
      >
        <span>{t.nav.press}</span>
        <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href={privacyUrl}
        class={`flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-sm font-medium transition-colors ${
          isPrivacyActive
            ? 'bg-orange-500/10 text-orange-600 dark:text-orange-400 font-semibold'
            : 'text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400'
        }`}
      >
        <span>{t.nav.privacy}</span>
        <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href={isHomePage ? '#contact' : `${homeUrl}#contact`}
        class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
      >
        <span>{t.nav.support}</span>
        <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <div class="pt-2 mt-1 border-t border-stone-200/80 dark:border-stone-800/80">
        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-2.5 rounded-2xl text-xs font-semibold bg-orange-600 text-white shadow-sm hover:bg-orange-700 active:scale-[0.99] transition-all"
        >
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub @kd-labs-io</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');
    if (!btn || !menu) return;

    function syncMenuState(isOpen) {
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
      }
    }

    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      syncMenuState(!isHidden);
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        syncMenuState(false);
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
