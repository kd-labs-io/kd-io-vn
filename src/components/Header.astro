---
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';
import { siteConfig } from '../config/site';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSuggestionBanner from './LanguageSuggestionBanner.astro';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = getTranslations(currentLang);
const homeUrl = currentLang === 'vi' ? '/' : `/${currentLang}/`;
const isHomePage = currentLang === 'vi'
  ? (Astro.url.pathname === '/' || Astro.url.pathname === '')
  : (Astro.url.pathname === `/${currentLang}/` || Astro.url.pathname === `/${currentLang}`);
const pressUrl = currentLang === 'vi' ? '/press/' : `/${currentLang}/press/`;
const privacyUrl = currentLang === 'vi' ? '/privacy/' : `/${currentLang}/privacy/`;
const blogUrl = currentLang === 'vi' ? '/blog/' : `/${currentLang}/blog/`;
---

<header class="sticky top-0 z-50 transition-colors duration-200">
  <!-- Language Suggestion Top Banner -->
  <LanguageSuggestionBanner currentLang={currentLang} />

  <div class="backdrop-blur-md bg-stone-50/85 dark:bg-[#0F0E0D]/85 border-b border-stone-200/80 dark:border-stone-800/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo KD Labs -->
      <a href={homeUrl} class="group flex items-center space-x-2.5 sm:space-x-3 text-inherit no-underline shrink-0">
        <!-- Zen Enso Ring Logo -->
        <div class="relative w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl bg-orange-500/10 dark:bg-orange-500/15 border border-orange-500/30 group-hover:border-orange-500 transition-colors duration-300 shrink-0">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-orange-600 dark:text-orange-500 transition-transform duration-300 group-hover:scale-105" viewBox="0 0 24 24" fill="none">
            <!-- Zen Enso open circle & 2 circles (Key & Data) -->
            <path
              d="M 13.5 3.1 A 8.9 8.9 0 1 0 20.5 15.6"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
            />
            <circle cx="15.6" cy="6.8" r="2" class="fill-orange-400 dark:fill-orange-400" />
            <circle cx="18.8" cy="11.5" r="2" class="fill-orange-400 dark:fill-orange-400" />
          </svg>
        </div>
        
        <div class="flex flex-col">
          <span class="text-base sm:text-xl font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-tight flex items-center gap-1.5">
            KD Labs
          </span>
          <span class="text-[9px] sm:text-[10px] uppercase tracking-wider sm:tracking-widest text-stone-500 dark:text-stone-400 font-medium">
            Keep Development
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
        <a
          href={isHomePage ? '#showcase' : `${homeUrl}#showcase`}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.apps}
        </a>
        <a
          href={isHomePage ? '#philosophy' : `${homeUrl}#philosophy`}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.philosophy}
        </a>
        <a
          href={blogUrl}
          class={`transition-colors duration-150 ${
            Astro.url.pathname.includes('/blog')
              ? 'text-orange-600 dark:text-orange-400 font-semibold'
              : 'text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400'
          }`}
        >
          {t.nav.blog}
        </a>
        <a
          href={pressUrl}
          class={`transition-colors duration-150 ${
            Astro.url.pathname.includes('/press')
              ? 'text-orange-600 dark:text-orange-400 font-semibold'
              : 'text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400'
          }`}
        >
          {t.nav.press}
        </a>
        <a
          href={privacyUrl}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.privacy}
        </a>
        <a
          href={isHomePage ? '#contact' : `${homeUrl}#contact`}
          class="text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors duration-150"
        >
          {t.nav.support}
        </a>
      </nav>

      <!-- Desktop Right Controls -->
      <div class="hidden md:flex items-center space-x-3">
        <!-- Language Switcher -->
        <LanguagePicker currentLang={currentLang} />

        <!-- Theme Toggle -->
        <ThemeToggle />

        <!-- GitHub Organization Button -->
        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-stone-900 text-stone-50 hover:bg-orange-600 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-orange-500 dark:hover:text-white transition-all duration-200 shadow-sm"
        >
          <!-- GitHub Icon -->
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub @kd-labs-io</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center space-x-1.5 sm:space-x-2 md:hidden">
        <LanguagePicker currentLang={currentLang} />
        <ThemeToggle />
        
        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-full border border-stone-200 dark:border-stone-800 bg-stone-100/70 dark:bg-stone-900/80 text-stone-700 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-300 dark:hover:border-orange-800/60 transition-all duration-200 shadow-sm cursor-pointer active:scale-95"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg id="mobile-menu-icon-open" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="mobile-menu-icon-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-stone-200/80 dark:border-stone-800/80 bg-stone-50/95 dark:bg-[#121110]/95 backdrop-blur-xl px-4 pt-3 pb-5 space-y-1.5 shadow-xl">
    <a
      href={isHomePage ? '#showcase' : `${homeUrl}#showcase`}
      class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
    >
      <span>{t.nav.apps}</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
    <a
      href={isHomePage ? '#philosophy' : `${homeUrl}#philosophy`}
      class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
    >
      <span>{t.nav.philosophy}</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
    <a
      href={blogUrl}
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors ${
        Astro.url.pathname.includes('/blog')
          ? 'bg-orange-500/10 text-orange-600 dark:text-orange-400 font-semibold'
          : 'text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400'
      }`}
    >
      <span>{t.nav.blog}</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
    <a
      href={pressUrl}
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors ${
        Astro.url.pathname.includes('/press')
          ? 'bg-orange-500/10 text-orange-600 dark:text-orange-400 font-semibold'
          : 'text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400'
      }`}
    >
      <span>{t.nav.press}</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
    <a
      href={privacyUrl}
      class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
    >
      <span>{t.nav.privacy}</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
    <a
      href={isHomePage ? '#contact' : `${homeUrl}#contact`}
      class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-orange-500/10 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
    >
      <span>{t.nav.support}</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
    <div class="pt-2.5 mt-1 border-t border-stone-200/80 dark:border-stone-800/80">
      <a
        href={siteConfig.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-xs font-semibold bg-orange-600 text-white shadow-sm hover:bg-orange-700 active:scale-[0.99] transition-all"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub @kd-labs-io</span>
      </a>
    </div>
  </div>
  </div>
</header>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');
    if (!btn || !menu) return;

    function syncMenuState(isOpen) {
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
      }
    }

    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      syncMenuState(!isHidden);
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        syncMenuState(false);
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
