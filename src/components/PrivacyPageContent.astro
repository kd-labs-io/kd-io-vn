---
import type { Locale } from '../data/i18n';
import { privacyData } from '../data/privacyData';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const data = privacyData[currentLang];
const homeUrl = currentLang === 'vi' ? '/' : `/${currentLang}/`;

const printLabel = currentLang === 'vi' ? 'In văn bản / Lưu PDF' : 'Print / Save as PDF';
const copyLinkSuccess = currentLang === 'vi' ? 'Đã sao chép liên kết mục!' : 'Section link copied!';
const jumpToSectionLabel = currentLang === 'vi' ? 'Mục lục nhanh' : 'Jump to section';
const backToTopLabel = currentLang === 'vi' ? 'Về đầu trang' : 'Back to top';
const itemsCountLabel = currentLang === 'vi' ? `${data.sections.length} Mục` : `${data.sections.length} Items`;
---

<div class="py-8 sm:py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Action / Breadcrumb Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-200 dark:border-stone-800 pb-4 sm:pb-5 mb-6 sm:mb-8">
      <a
        href={homeUrl}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full craft-card text-xs font-semibold text-stone-700 dark:text-stone-200 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-500/50 transition-all"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{data.backToHome}</span>
      </a>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Google Play & Open-Source Verified</span>
        </span>

        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-stone-100 dark:bg-stone-800/80 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-colors cursor-pointer"
          title={printLabel}
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span class="hidden sm:inline">{printLabel}</span>
        </button>
      </div>
    </div>

    <!-- Main Header Section -->
    <header class="max-w-4xl space-y-4 mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-orange-50 dark:bg-orange-950/40 text-orange-700 dark:text-orange-400 border border-orange-200 dark:border-orange-900/50">
        <svg class="w-4 h-4 text-orange-600 dark:text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>{data.badge}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-stone-900 dark:text-stone-50">
        {data.title}
      </h1>

      <!-- Metadata chips -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-mono text-stone-500 dark:text-stone-400">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {data.effectiveDate}
        </span>
        <span>•</span>
        <span>{data.lastUpdated}</span>
        <span>•</span>
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {data.readingTime}
        </span>
      </div>

      <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 leading-relaxed font-normal pt-2">
        {data.intro}
      </p>
    </header>

    <!-- Highlights Banner: At a Glance (4 Pillars) -->
    <div class="mb-8 sm:mb-10 rounded-2xl sm:rounded-3xl p-5 sm:p-6 bg-gradient-to-br from-orange-50/70 via-stone-50/90 to-stone-100/70 dark:from-orange-950/20 dark:via-[#161412] dark:to-stone-900/50 border border-orange-200/80 dark:border-orange-900/40 shadow-xs">
      <div class="max-w-2xl mb-4 sm:mb-5">
        <h2 class="text-lg sm:text-xl font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>
          {data.highlightsTitle}
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mt-1">
          {data.highlightsSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
        {data.highlights.map((item) => (
          <div class="bg-white/80 dark:bg-[#1a1715]/80 backdrop-blur-xs rounded-2xl p-3.5 sm:p-4 border border-stone-200/80 dark:border-stone-800/80 space-y-2 flex flex-col justify-between">
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold font-mono px-2 py-0.5 rounded-md bg-orange-100/70 dark:bg-orange-950/60 text-orange-700 dark:text-orange-400 border border-orange-200/50 dark:border-orange-900/50">
                  {item.tag}
                </span>
              </div>
              <h3 class="text-sm font-bold text-stone-900 dark:text-stone-100">
                {item.title}
              </h3>
              <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile Table of Contents Accordion (visible on < lg) -->
    <div class="lg:hidden mb-8">
      <details class="group rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#181614] overflow-hidden shadow-xs">
        <summary class="flex items-center justify-between p-4 cursor-pointer font-semibold text-sm text-stone-900 dark:text-stone-100 select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-orange-600 dark:text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span>{jumpToSectionLabel} ({data.sections.length} mục)</span>
          </span>
          <svg class="w-4 h-4 text-stone-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="p-4 pt-0 border-t border-stone-100 dark:border-stone-800 space-y-1.5 max-h-80 overflow-y-auto">
          {data.sections.map((sec) => (
            <a
              href={`#${sec.id}`}
              class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-stone-600 dark:text-stone-300 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-stone-50 dark:hover:bg-stone-800/50 transition-colors"
            >
              <span class="font-mono text-orange-600 dark:text-orange-400 mr-2">{sec.number}.</span>
              <span>{sec.title}</span>
            </a>
          ))}
        </div>
      </details>
    </div>

    <!-- 2-Column Grid Layout: Main Content (9 cols) + Sticky TOC (3 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN: Comprehensive Sections -->
      <main class="lg:col-span-9 space-y-8 sm:space-y-10 min-w-0">
        {data.sections.map((section) => (
          <section
            id={section.id}
            class="privacy-section scroll-mt-24 rounded-2xl sm:rounded-3xl craft-card p-5 sm:p-7 space-y-5"
          >
            <!-- Section Header -->
            <div class="space-y-2 border-b border-stone-100 dark:border-stone-800/80 pb-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-orange-600 dark:text-orange-400 px-2.5 py-0.5 rounded-full bg-orange-50 dark:bg-orange-950/50 border border-orange-200/40 dark:border-orange-900/40">
                  Điều / Section {section.number}
                </span>
                <a
                  href={`#${section.id}`}
                  class="copy-anchor-btn text-stone-400 hover:text-orange-600 dark:hover:text-orange-400 p-1 rounded-md transition-colors"
                  title="Copy direct link to this section"
                  data-section-id={section.id}
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                </a>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-stone-900 dark:text-stone-50 tracking-tight pt-1">
                {section.title}
              </h2>
            </div>

            <!-- Main Paragraphs -->
            <div class="space-y-3.5 text-sm sm:text-base text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
              {section.content.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            <!-- Callout Box (if present at section level) -->
            {section.callout && (
              <div class={`p-4 sm:p-5 rounded-2xl border text-sm leading-relaxed ${
                section.callout.type === 'shield'
                  ? 'bg-emerald-50/70 dark:bg-emerald-950/20 border-emerald-200 dark:border-emerald-900/50 text-emerald-950 dark:text-emerald-200'
                  : section.callout.type === 'alert'
                  ? 'bg-rose-50/70 dark:bg-rose-950/20 border-rose-200 dark:border-rose-900/50 text-rose-950 dark:text-rose-200'
                  : 'bg-orange-50/60 dark:bg-orange-950/20 border-orange-200 dark:border-orange-900/50 text-orange-950 dark:text-orange-200'
              }`}>
                <div class="font-bold flex items-center gap-2 mb-1.5 text-stone-900 dark:text-stone-100">
                  {section.callout.type === 'shield' && (
                    <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  )}
                  {section.callout.type === 'alert' && (
                    <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                  )}
                  {section.callout.type === 'info' && (
                    <svg class="w-4 h-4 text-orange-600 dark:text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  )}
                  <span>{section.callout.title}</span>
                </div>
                <div class="text-xs sm:text-sm whitespace-pre-line text-stone-700 dark:text-stone-300">
                  {section.callout.text}
                </div>
              </div>
            )}

            <!-- Responsive Table (if present at section level) -->
            {section.table && (
              <div class="overflow-x-auto rounded-2xl border border-stone-200 dark:border-stone-800 -mx-1 sm:mx-0">
                <table class="w-full text-left text-xs sm:text-sm text-stone-700 dark:text-stone-300">
                  <thead class="bg-stone-50 dark:bg-stone-900/80 text-stone-900 dark:text-stone-100 font-semibold border-b border-stone-200 dark:border-stone-800">
                    <tr>
                      {section.table.headers.map((h, idx) => {
                        const isStatusCol = (section.id === 'google-play-data-safety' || section.number === '03') && (idx === 1 || idx === 2);
                        return (
                          <th class={`px-3.5 py-2.5 sm:px-4 sm:py-3 ${isStatusCol ? 'text-center whitespace-nowrap min-w-[140px]' : idx === 0 ? 'min-w-[160px]' : ''}`}>
                            {h}
                          </th>
                        );
                      })}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-stone-100 dark:divide-stone-800/80">
                    {section.table.rows.map((row) => (
                      <tr class="hover:bg-stone-50/50 dark:hover:bg-stone-900/40 transition-colors">
                        {row.map((cell, idx) => {
                          const isStatus = cell === 'KHÔNG THU THẬP' || cell === 'NOT COLLECTED' || cell === 'KHÔNG CHIA SẺ' || cell === 'NOT SHARED';
                          return (
                            <td class={`px-3.5 py-2.5 sm:px-4 sm:py-3 align-top ${
                              isStatus 
                                ? 'text-center whitespace-nowrap' 
                                : idx === 0 
                                ? 'font-medium text-stone-900 dark:text-stone-100' 
                                : 'text-stone-600 dark:text-stone-400'
                            }`}>
                              {cell.includes('\n') ? (
                                <div class="whitespace-pre-line font-mono text-xs">{cell}</div>
                              ) : isStatus ? (
                                <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-xs font-mono font-bold whitespace-nowrap shrink-0 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/50">
                                  {cell}
                                </span>
                              ) : (
                                cell
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <!-- Subsections (if any) -->
            {section.subsections && (
              <div class="space-y-4 pt-1">
                {section.subsections.map((sub) => (
                  <div class="rounded-2xl bg-stone-50/60 dark:bg-stone-900/30 p-4 sm:p-5 border border-stone-100 dark:border-stone-800/60 space-y-2.5">
                    <h3 class="text-base sm:text-lg font-bold text-stone-900 dark:text-stone-100">
                      {sub.title}
                    </h3>
                    <div class="space-y-2 text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
                      {sub.content.map((p) => (
                        <p class="whitespace-pre-line">{p}</p>
                      ))}
                    </div>

                    {sub.callout && (
                      <div class="mt-3 p-4 rounded-xl bg-rose-50/80 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 text-xs sm:text-sm text-rose-900 dark:text-rose-200">
                        <div class="font-bold mb-1 flex items-center gap-1.5">
                          <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                          </svg>
                          <span>{sub.callout.title}</span>
                        </div>
                        <p>{sub.callout.text}</p>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}

        <!-- Developer Contact & DPO Card (Section 12 details card) -->
        <div class="rounded-2xl sm:rounded-3xl border border-stone-200 dark:border-stone-800 bg-gradient-to-br from-stone-50 to-orange-50/40 dark:from-stone-900/50 dark:to-orange-950/20 p-5 sm:p-7 space-y-4">
          <div class="space-y-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-orange-100/70 dark:bg-orange-950/60 text-orange-800 dark:text-orange-300">
              {data.contactBox.entityName}
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-stone-900 dark:text-stone-100">
              {data.contactBox.title}
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 leading-relaxed font-normal">
              {data.contactBox.description}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
            <div class="p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-[#181614] border border-stone-200 dark:border-stone-800 space-y-1">
              <span class="text-xs text-stone-500 dark:text-stone-400 font-mono">Email Hỗ Trợ & Bảo Mật:</span>
              <a
                href={`mailto:${data.contactBox.supportEmail}`}
                class="block text-sm font-bold text-orange-600 dark:text-orange-400 hover:underline"
              >
                {data.contactBox.supportEmail}
              </a>
            </div>

            <div class="p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-[#181614] border border-stone-200 dark:border-stone-800 space-y-1">
              <span class="text-xs text-stone-500 dark:text-stone-400 font-mono">GitHub Repository:</span>
              <a
                href={data.contactBox.githubRepo}
                target="_blank"
                rel="noopener noreferrer"
                class="block text-sm font-bold text-stone-900 dark:text-stone-100 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
              >
                github.com/kd-labs-io/simple-otp ↗
              </a>
            </div>
          </div>

          <div class="p-3.5 sm:p-4 rounded-2xl bg-stone-100/70 dark:bg-stone-900/60 border border-stone-200/80 dark:border-stone-800/80 text-xs text-stone-600 dark:text-stone-400 leading-relaxed">
            <p class="font-medium text-stone-900 dark:text-stone-200 mb-1">Ghi chú về bảo mật nâng cao:</p>
            {data.contactBox.gpgKeyNote}
          </div>
        </div>

      </main>

      <!-- RIGHT COLUMN: Sticky Table of Contents Sidebar (visible on lg+) -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-28 space-y-4">
        <div class="rounded-2xl sm:rounded-3xl border border-stone-200/90 dark:border-stone-800/90 bg-white/90 dark:bg-[#161412]/90 backdrop-blur-md p-4 sm:p-5 space-y-4 shadow-xs">
          
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pb-2.5">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">
              {data.tableOfContentsTitle}
            </h3>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300">
              {itemsCountLabel}
            </span>
          </div>

          <!-- Nav Items -->
          <nav class="toc-nav space-y-0.5 max-h-[calc(100vh-250px)] overflow-y-auto pr-1">
            {data.sections.map((sec) => (
              <a
                href={`#${sec.id}`}
                id={`toc-link-${sec.id}`}
                class="toc-item group flex items-start gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 hover:bg-stone-100/70 dark:hover:bg-stone-800/50 transition-all leading-snug"
              >
                <span class="font-mono text-[11px] font-bold text-orange-600/70 dark:text-orange-400/70 group-hover:text-orange-600 dark:group-hover:text-orange-400 shrink-0 pt-0.5">
                  {sec.number}.
                </span>
                <span class="group-hover:translate-x-0.5 transition-transform break-words">
                  {sec.title}
                </span>
              </a>
            ))}
          </nav>

          <!-- Quick Jump Footer Actions -->
          <div class="pt-2.5 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between text-xs">
            <button
              type="button"
              onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
              class="inline-flex items-center gap-1.5 text-stone-500 dark:text-stone-400 hover:text-orange-600 dark:hover:text-orange-400 transition-colors cursor-pointer text-xs"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
              <span>{backToTopLabel}</span>
            </button>

            <a
              href={data.contactBox.githubRepo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors text-xs"
            >
              <span>GitHub</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

        </div>
      </aside>

    </div>

  </div>
</div>

<!-- Toast notification for copy anchor link -->
<div
  id="privacy-toast"
  class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none px-4 py-2.5 rounded-2xl bg-stone-900 dark:bg-stone-100 text-stone-100 dark:text-stone-900 text-xs font-semibold shadow-xl flex items-center gap-2"
>
  <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
  <span id="privacy-toast-msg">{copyLinkSuccess}</span>
</div>

<script is:inline>
  // Active Section Highlighting using IntersectionObserver
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.privacy-section');
    const tocLinks = document.querySelectorAll('.toc-item');
    const toast = document.getElementById('privacy-toast');

    if (!sections.length || !tocLinks.length) return;

    const observerOptions = {
      root: null,
      rootMargin: '-100px 0px -60% 0px',
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach((link) => {
            const isCurrent = link.getAttribute('href') === `#${id}`;
            if (isCurrent) {
              link.classList.add(
                'bg-orange-50',
                'dark:bg-orange-950/40',
                'text-orange-600',
                'dark:text-orange-400',
                'font-bold'
              );
              link.classList.remove('text-stone-600', 'dark:text-stone-400');
            } else {
              link.classList.remove(
                'bg-orange-50',
                'dark:bg-orange-950/40',
                'text-orange-600',
                'dark:text-orange-400',
                'font-bold'
              );
              link.classList.add('text-stone-600', 'dark:text-stone-400');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((sec) => observer.observe(sec));

    // Copy anchor button functionality
    const copyBtns = document.querySelectorAll('.copy-anchor-btn');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const sectionId = btn.getAttribute('data-section-id');
        const url = `${window.location.origin}${window.location.pathname}#${sectionId}`;
        
        navigator.clipboard.writeText(url).then(() => {
          if (toast) {
            toast.classList.remove('translate-y-16', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
              toast.classList.remove('translate-y-0', 'opacity-100');
              toast.classList.add('translate-y-16', 'opacity-0');
            }, 2500);
          }
          // Also smooth scroll into view
          const el = document.getElementById(sectionId);
          if (el) el.scrollIntoView({ behavior: 'smooth' });
          history.replaceState(null, '', `#${sectionId}`);
        });
      });
    });
  });
</script>
