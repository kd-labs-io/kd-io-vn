---
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';
import { siteConfig } from '../config/site';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = getTranslations(currentLang);
const homeUrl = currentLang === 'vi' ? '/' : `/${currentLang}/`;
const pressUrl = currentLang === 'vi' ? '/press/' : `/${currentLang}/press/`;
const privacyUrl = currentLang === 'vi' ? '/privacy/' : `/${currentLang}/privacy/`;
const termsUrl = currentLang === 'vi' ? '/terms/' : `/${currentLang}/terms/`;
const blogUrl = currentLang === 'vi' ? '/blog/' : `/${currentLang}/blog/`;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-stone-200/80 dark:border-stone-800/80 bg-stone-100/60 dark:bg-[#0C0B0A] text-stone-600 dark:text-stone-300 py-16 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-stone-200 dark:border-stone-800/80">
      
      <!-- Studio Intro (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        <a href={homeUrl} class="inline-flex items-center space-x-3 text-inherit no-underline">
          <div class="w-8 h-8 rounded-xl bg-orange-500/15 border border-orange-500/30 flex items-center justify-center text-orange-600 dark:text-orange-500">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
              <path d="M 13.5 3.1 A 8.9 8.9 0 1 0 20.5 15.6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
              <circle cx="15.6" cy="6.8" r="2" class="fill-orange-400 dark:fill-orange-400" />
              <circle cx="18.8" cy="11.5" r="2" class="fill-orange-400 dark:fill-orange-400" />
            </svg>
          </div>
          <span class="text-lg font-bold text-stone-900 dark:text-stone-100">KD Labs</span>
        </a>

        <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed max-w-sm">
          {t.footer.description}
        </p>

        <!-- Google Play Developer Badge Link -->
        <div class="pt-2">
          <a
            href={siteConfig.googlePlayDevUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-stone-900 text-stone-100 dark:bg-stone-800 dark:text-stone-100 text-xs font-medium hover:bg-orange-600 dark:hover:bg-orange-600 transition-colors"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186c-.37-.367-.61-.88-.61-1.464V3.278c0-.584.24-1.097.61-1.464zm1.402-.822L16.273 7.42 14.5 9.193 5.011.992zm9.49 9.873l1.774 1.774-11.264 6.43 9.49-8.204zm2.463-.997l2.827 1.616c.82.469.82 1.233 0 1.701l-2.827 1.616-1.993-1.993 1.993-1.94z"/>
            </svg>
            <span>{t.nav.googlePlay}</span>
          </a>
        </div>
      </div>

      <!-- Quick Links (3 cols) -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs uppercase font-bold tracking-wider text-stone-900 dark:text-stone-100">
          {t.footer.quickLinks}
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href={`${homeUrl}#showcase`} class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              {t.nav.apps}
            </a>
          </li>
          <li>
            <a href={`${homeUrl}#philosophy`} class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              {t.nav.philosophy}
            </a>
          </li>
          <li>
            <a href={blogUrl} class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              {t.nav.blog}
            </a>
          </li>
          <li>
            <a href={pressUrl} class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              {t.nav.press}
            </a>
          </li>
          <li>
            <a href={`${homeUrl}#contact`} class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              {t.nav.support}
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal (4 cols) -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs uppercase font-bold tracking-wider text-stone-900 dark:text-stone-100">
          {t.footer.legal}
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href={privacyUrl} class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              {t.footer.privacyPolicy}
            </a>
          </li>
          <li>
            <a href={termsUrl} class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
              {t.footer.termsOfService}
            </a>
          </li>
          <li>
            <span class="text-stone-600 dark:text-stone-300">
              Google Play Console Compliance: Verified
            </span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-600 dark:text-stone-300 gap-4 text-center sm:text-left">
      <div>
        <p>© {currentYear} KD Labs • {currentLang === 'vi' ? 'Phát triển bởi Bùi Khương Duy' : 'Developed by Bui Khuong Duy'}. {t.footer.allRightsReserved}</p>
        <p class="text-[11px] text-stone-600 dark:text-stone-300 mt-1">
          {t.footer.googlePlayNotice}
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>All systems operational</span>
      </div>
    </div>

  </div>
</footer>
